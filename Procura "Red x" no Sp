----------------------------------------------------------------
-- UTIL
----------------------------------------------------------------
local function getRoot()
    local c = Plr.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function posOf(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
end

local function norm(s)
    return (tostring(s):lower():gsub("[%s_%-%.]", ""))
end

local function isCharacterPart(v)
    local m = v:FindFirstAncestorOfClass("Model")
    while m do
        if m:FindFirstChildOfClass("Humanoid") then return true end
        m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
    end
    return false
end

local npcFolder = workspace:FindFirstChild("NPCs")
local serviceFolder = workspace:FindFirstChild("ServiceNPCs")

local function textMatches(text)
    local n = norm(text)
    if State.CustomName ~= "" then
        return n:find(norm(State.CustomName), 1, true) ~= nil
    end
    return n:find("redx", 1, true) ~= nil
        or n == "x"
        or n:find("xmark", 1, true) ~= nil
end

local function matchTarget(v)
    if v:IsA("ProximityPrompt") then
        if textMatches(v.Name) or textMatches(v.ActionText) or textMatches(v.ObjectText) then
            return v.Parent
        end
        return nil
    end
    if v:IsA("ClickDetector") then
        if State.CustomName ~= "" and textMatches(v.Name) then return v.Parent end
        return nil
    end
    if v:IsA("BasePart") or v:IsA("Model") then
        if textMatches(v.Name) then return v end
    end
    return nil
end

local function scanAll(includeSkipped)
    local found, seen = {}, {}
    for _, v in ipairs(workspace:GetDescendants()) do
        local t = matchTarget(v)
        if t and t.Parent and not seen[t]
            and not (npcFolder and t:IsDescendantOf(npcFolder))
            and not (serviceFolder and t:IsDescendantOf(serviceFolder))
            and not isCharacterPart(t) then
            if includeSkipped or not State.Skipped[t] then
                seen[t] = true
                found[#found + 1] = t
            end
        end
    end
    return found
end

local function nearestFrom(list, from)
    local best, bestD = nil, math.huge
    for _, t in ipairs(list) do
        local p = posOf(t)
        if p then
            local d = (p - from).Magnitude
            if d < bestD then best, bestD = t, d end
        end
    end
    return best
end

local function nearestIsland(pos)
    local best, bestD = nil, math.huge
    for name, p in pairs(CRYSTALS) do
        local folder = workspace:FindFirstChild(p[1])
        local crystal = folder and folder:FindFirstChild(p[2])
        if crystal then State.IslandPos[name] = crystal:GetPivot().Position end
    end
    for name, ip in pairs(State.IslandPos) do
        local d = (ip - pos).Magnitude
        if d < bestD then best, bestD = name, d end
    end
    return best
end

----------------------------------------------------------------
-- MOVIMENTO
----------------------------------------------------------------
local moveConn = RunService.Stepped:Connect(function()
    if not State.Flying then return end
    local c = Plr.Character
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
        local r = c:FindFirstChild("HumanoidRootPart")
        if r then r.AssemblyLinearVelocity = Vector3.zero end
    end
end)

local function flyTo(pos)
    local root = getRoot()
    if not root then return false end
    State.Flying = true

    local dist = (root.Position - pos).Magnitude
    local time = math.max(dist / Options.FlySpeed.Value, 0.05)
    local tw = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    })
    State.Tween = tw
    tw:Play()
    local st = tw.Completed:Wait()
    State.Tween = nil

    State.Flying = false
    local r = getRoot()
    if r then r.AssemblyLinearVelocity = Vector3.zero end
    return st == Enum.PlaybackState.Completed and Toggles.GoToX.Value
end

-- TP para a ilha. Se ela tem varios nomes possiveis, testa ate o personagem se mover.
local function tpIsland(island)
    State.Status = "TP para ilha: " .. island
    local defs = ALIASES[island] or {island}
    local names = {}
    if State.GoodAlias[island] then table.insert(names, State.GoodAlias[island]) end
    for _, n in ipairs(defs) do
        if n ~= State.GoodAlias[island] then table.insert(names, n) end
    end

    for i, name in ipairs(names) do
        local root = getRoot()
        local before = root and root.Position
        TP_Portal:FireServer(name)
        task.wait(i == 1 and Options.IslandWait.Value or 1.5)

        root = getRoot()
        if #names == 1 then break end
        if root and before and (root.Position - before).Magnitude > 80 then
            State.GoodAlias[island] = name
            break
        end
    end

    local r = getRoot()
    if r then State.IslandPos[island] = r.Position end
end

local function dropLock(markSkipped)
    local L = State.Lock
    if L and markSkipped and L.inst then State.Skipped[L.inst] = true end
    State.Lock = nil
end

local function skipCurrent()
    dropLock(true)
    if State.Tween then State.Tween:Cancel() end
    State.Flying = false
    Library:Notify("Alvo pulado. Escolhendo outro...", 2)
end

----------------------------------------------------------------
-- ACHAR / TRAVAR UM ALVO
----------------------------------------------------------------
local function lockOn(inst, island)
    local pos = posOf(inst)
    if not pos then return false end
    island = island or nearestIsland(pos)
    State.Lock = { inst = inst, pos = pos, island = island, name = inst.Name, tries = 0, hits = 0 }
    Library:Notify("Foco: " .. inst.Name .. (island and (" (" .. island .. ")") or ""), 3)
    return true
end

-- Retorna false SO depois de checar o lugar atual + TODAS as ilhas da lista
-- sem achar nenhum X (e a condicao pro server hop).
local function acquire()
    State.Status = "Procurando X..."
    local list = table.clone(ISLANDS)
    if Toggles.ExtraIslands.Value then
        for _, n in ipairs(EXTRA_ISLANDS) do table.insert(list, n) end
    end

    local root = getRoot()
    if root then
        local t = nearestFrom(scanAll(false), root.Position)
        if t then return lockOn(t) end
    end

    for _ = 1, #list do
        if not Toggles.GoToX.Value then return false end
        if State.IslandIdx > #list then State.IslandIdx = 1 end
        local island = list[State.IslandIdx]
        State.IslandIdx += 1

        tpIsland(island)
        root = getRoot()
        if root then
            local t = nearestFrom(scanAll(false), root.Position)
            if t then return lockOn(t, island) end
        end
    end
    return false
end

local function resolveLock(L)
    if L.inst and L.inst.Parent then return L.inst end
    local near
    local bestD = 120
    for _, t in ipairs(scanAll(false)) do
        local p = posOf(t)
        if p then
            local d = (p - L.pos).Magnitude
            if d < bestD then near, bestD = t, d end
        end
    end
    return near
end

----------------------------------------------------------------
-- INTERACAO
----------------------------------------------------------------
local function interact(target)
    local prompts = {}
    if target:IsA("ProximityPrompt") then table.insert(prompts, target) end
    for _, d in ipairs(target:GetDescendants()) do
        if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
    end
    local chosen = prompts[1]
    if State.CustomName ~= "" then
        for _, p in ipairs(prompts) do
            if textMatches(p.Name) or textMatches(p.ActionText) or textMatches(p.ObjectText) then
                chosen = p break
            end
        end
    end
    if chosen and fireproximityprompt then
        chosen.HoldDuration = 0
        chosen.RequiresLineOfSight = false
        fireproximityprompt(chosen)
        return true
    end
    local click = target:FindFirstChildWhichIsA("ClickDetector", true)
    if click and fireclickdetector then
        fireclickdetector(click)
        return true
    end
    return false
end

----------------------------------------------------------------
-- LOOP PRINCIPAL (foco em UM alvo por vez)
----------------------------------------------------------------
local function MainLoop()
    while State.Running and Toggles.GoToX.Value do
        task.wait(0.2)
        if State.Hopping then continue end

        local root = getRoot()
        if not root then continue end

        if not State.Lock then
            if not acquire() then
                if not Toggles.GoToX.Value then break end

                -- varreu todas as ilhas e nao achou nenhum X
                if Toggles.AutoHop.Value then
                    State.Status = "Nenhum X em nenhuma ilha. Server hop..."
                    Library:Notify("Nenhum X em nenhuma ilha. Trocando de servidor...", 4)
                    table.clear(State.Skipped)
                    State.IslandIdx = 1
                    task.spawn(serverHop)
                    continue
                end

                State.Status = "Nenhum X no mapa todo"
                if Toggles.ClearWhenEmpty.Value then table.clear(State.Skipped) end
                task.wait(3)
                continue
            end
        end

        local L = State.Lock
        if not L then continue end

        root = getRoot()
        if L.island and root and (root.Position - L.pos).Magnitude > Options.FarDist.Value then
            tpIsland(L.island)
        end

        local inst = resolveLock(L)
        if inst then
            L.inst = inst
            L.pos = posOf(inst) or L.pos
        end

        State.Status = "Indo para: " .. L.name .. (L.island and (" [" .. L.island .. "]") or "")
        if not flyTo(L.pos) then continue end
        if State.Lock ~= L then continue end

        task.wait(0.15)
        inst = resolveLock(L)
        if not inst then
            root = getRoot()
            if root and (root.Position - L.pos).Magnitude < 60 then
                Library:Notify(L.name .. " sumiu. Trocando de alvo.", 3)
                dropLock(false)
            else
                L.tries += 1
                if L.tries >= 3 then dropLock(true) end
            end
            continue
        end
        L.inst = inst
        L.pos = posOf(inst) or L.pos

        State.Status = "Coletando: " .. L.name
        if Toggles.AutoInteract.Value then
            if not interact(inst) then
                Library:Notify("Sem prompt/click em: " .. inst:GetFullName(), 3)
            end
        end
        task.wait(Options.InteractDelay.Value)

        if not inst.Parent then
            dropLock(false)
        else
            L.hits += 1
            if L.hits >= 3 then dropLock(true) end
        end
    end
    State.Flying = false
    if not State.Hopping then State.Status = "parado" end
end

local MainThread
local function RunMain(on)
    if on then
        if not MainThread or coroutine.status(MainThread) == "dead" then
            MainThread = task.spawn(MainLoop)
        end
    else
        if State.Tween then State.Tween:Cancel() end
        State.Flying = false
        State.Lock = nil
    end
end

