----------------------------------------------------------------
local function fetchServers()
    local ids, cursor = {}, nil
    for _ = 1, 3 do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true")
            :format(game.PlaceId)
        if cursor then url = url .. "&cursor=" .. cursor end

        local ok, res = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not ok or type(res) ~= "table" or type(res.data) ~= "table" then break end

        for _, s in ipairs(res.data) do
            if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 then
                table.insert(ids, s.id)
            end
        end

        cursor = res.nextPageCursor
        if not cursor then break end
    end
    return ids
end

serverHop = function()
    if State.Hopping then return end
    State.Hopping = true

    if State.Tween then State.Tween:Cancel() end
    State.Flying = false
    State.Lock = nil
    State.Status = "Server hop: buscando servidor..."

    -- salva a config e liga o autoload pra continuar sozinho no novo servidor
    if fsOK then
        pcall(function()
            saveConfig()
            writefile(AUTO_FILE, "1")
        end)
    end

    -- re-executa o script sozinho no novo servidor (usa a copia salva em RedXHub/script.lua)
    if queue_on_teleport then
        local code
        if isfile and isfile("RedXHub/script.lua") then
            code = 'if not game:IsLoaded() then game.Loaded:Wait() end loadstring(readfile("RedXHub/script.lua"))()'
        else
            local url = Options.ScriptURL and Options.ScriptURL.Value or ""
            if url ~= "" then
                code = ('if not game:IsLoaded() then game.Loaded:Wait() end loadstring(game:HttpGet("%s"))()'):format(url)
            end
        end
        if code then pcall(queue_on_teleport, code) end
    end

    for attempt = 1, 6 do
        if not State.Running then break end

        local all = fetchServers()
        local fresh = {}
        for _, id in ipairs(all) do
            if not State.TriedServers[id] then fresh[#fresh + 1] = id end
        end
        if #fresh == 0 then fresh = all end

        if #fresh > 0 then
            local id = fresh[math.random(#fresh)]
            State.TriedServers[id] = true
            State.Status = ("Server hop: tentativa %d/6..."):format(attempt)
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, id, Plr)
            end)
            task.wait(10) -- se o teleporte funcionar, o script some aqui
        else
            State.Status = "Server hop: nenhum servidor achado, tentando de novo..."
            task.wait(3)
        end
    end

    -- ultimo recurso: teleporte normal pro mesmo jogo (servidor aleatorio)
    if State.Running then
        State.Status = "Server hop: teleporte padrao..."
        pcall(function() TeleportService:Teleport(game.PlaceId, Plr) end)
        task.wait(10)
    end

    State.Hopping = false
    State.Status = "Server hop falhou. Tentando de novo..."
end

