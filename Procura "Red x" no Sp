local FOLDER = "RedXHub"
local CFG_FILE = FOLDER .. "/config.json"
local AUTO_FILE = FOLDER .. "/autoload.txt"
local fsOK = (writefile and readfile and isfile and makefolder and delfile) and true or false

local SaveBox = SettingsTab:AddLeftGroupbox("Salvar / Autoload", "save")
local SaveStatus = SaveBox:AddLabel("...", true)

local function hasSave() return fsOK and isfile(CFG_FILE) end
local function hasAuto() return fsOK and isfile(AUTO_FILE) end

local function refreshSaveStatus()
    if not fsOK then
        SaveStatus:SetText("Seu executor nao suporta arquivos (writefile).")
        return
    end
    SaveStatus:SetText(string.format(
        "Save: <b>%s</b>\nAutoload: <b>%s</b>",
        hasSave() and "existe" or "nenhum",
        hasAuto() and "ligado" or "desligado"
    ))
end

local function collectConfig()
    local data = {}
    for name, t in pairs(Toggles) do data[name] = t.Value end
    for name, o in pairs(Options) do
        if o.Type == "Slider" or o.Type == "Input" then data[name] = o.Value end
    end
    return data
end

local function saveConfig()
    if not fsOK then return false end
    if not isfolder or not isfolder(FOLDER) then makefolder(FOLDER) end
    writefile(CFG_FILE, HttpService:JSONEncode(collectConfig()))
    return true
end

local function loadConfig()
    if not hasSave() then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CFG_FILE)) end)
    if not ok or type(data) ~= "table" then return false end

    -- aplica tudo, deixando o toggle principal por ultimo
    for name, v in pairs(data) do
        if name ~= "GoToX" then
            local o = Options[name] or Toggles[name]
            if o and o.SetValue then pcall(function() o:SetValue(v) end) end
        end
    end
    if data.GoToX ~= nil and Toggles.GoToX then
        pcall(function() Toggles.GoToX:SetValue(data.GoToX) end)
    end
    return true
end

SaveBox:AddButton({
