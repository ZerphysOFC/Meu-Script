local Notifications = {}
local Utils = {}

function Utils.resolve(path)
	if type(path) ~= "string" or path == "" then return nil end
	local cur, first = nil, true
	for seg in path:gmatch("[^%.]+") do
		if first then
			if seg == "LocalPlayer" then
				cur = LocalPlayer
			else
				local ok, s = pcall(game.GetService, game, seg)
				cur = (ok and s) or game:FindFirstChild(seg)
			end
			first = false
		else
			cur = cur and cur:FindFirstChild(seg)
		end
		if not cur then return nil end
	end
	return cur
end

function Utils.need(id, key)
	local p = Configuration.Paths[key]
	if not p or p == "" then
		Toggles.Set(id, false)
		Notifications.Push("Configuração necessária",
			"Defina o caminho '" .. key .. "' em Configurações > Caminhos.", "warn")
		return nil
	end
	return Utils.resolve(p)
end

function Utils.call(remote, ...)
	if remote:IsA("RemoteEvent") then
		remote:FireServer(...)
		return true
	elseif remote:IsA("RemoteFunction") then
		return remote:InvokeServer(...)
	end
	error("Instância não é Remote: " .. remote:GetFullName())
end

local errAt = {}
function Utils.softError(tag, err)
	if os.clock() - (errAt[tag] or 0) > 10 then
		errAt[tag] = os.clock()
		warn("[BegABaddiesHub] " .. tostring(tag) .. ": " .. tostring(err))
		Notifications.Push(tag, "Erro (segue rodando): " .. tostring(err), "warn")
	end
end

