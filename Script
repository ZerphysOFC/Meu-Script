-- Tela de carregamento (vídeo com som + barra sincronizada + "ZRP" + botão Ignorar)
--==================================================================
-- O vídeo é tocado como "quadros" (folhas de imagens) + áudio, pois muitos executors não tocam vídeo local.
local SHEET_PREFIX = "ZRP2_sheet" -- ZRP2_sheet1.jpg ... ZRP2_sheet4.jpg
local SHEET_COUNT = 4
local AUDIO_FILE = "ZRP2_audio.mp3"
local FRAME_W, FRAME_H, COLS, ROWS = 168, 168, 6, 6
local FPS, FRAMES = 12, 144
local DURATION = FRAMES / FPS -- 12 s

-- Fechamento mínimo enquanto carrega (a versão completa é definida mais abaixo)
function Hub.Destroy()
	Hub.Destroyed = true
	for _, c in ipairs(Hub.Cleanup) do
		pcall(function()
			if typeof(c) == "RBXScriptConnection" then c:Disconnect() else c:Destroy() end
		end)
	end
	if env.BegABaddiesHub == Hub then env.BegABaddiesHub = nil end
end

local function runLoadingScreen()
	local sg = create("ScreenGui", {
		Name = "BegABaddiesHubLoading", ResetOnSpawn = false, DisplayOrder = 1000, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = safeParent(),
	})
	table.insert(Hub.Cleanup, sg)

	-- fundo semi-transparente: dá para ver o jogo atrás
	local backdrop = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 6, 14),
		BackgroundTransparency = 0.55, BorderSizePixel = 0, Parent = sg,
	})
	local card = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(404, 326),
		BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.25, Parent = backdrop,
	}, { round(16), stroke(Theme.Accent, 1.5, 0.35) })

	-- o vídeo é quadrado (1:1)
	local vidHolder = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(238, 238),
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, ClipsDescendants = true, Parent = card,
	}, { round(12) })
	local frame = create("ImageLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = "", ScaleType = Enum.ScaleType.Stretch,
		ImageRectSize = Vector2.new(FRAME_W, FRAME_H), Parent = vidHolder,
	})
	local zrp = create("TextLabel", {
		Text = "ZRP", Font = Theme.FontBold, TextSize = 72, TextColor3 = Theme.Accent2, BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), Visible = false, Parent = vidHolder,
	})

	local bar = create("Frame", {
		Position = UDim2.fromOffset(14, 264), Size = UDim2.new(1, -28, 0, 12), BackgroundColor3 = Theme.Off,
		BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = card,
	}, { round(6) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.15,
		BorderSizePixel = 0, Parent = bar,
	}, { round(6) })
	local pct = create("TextLabel", {
		Text = "Carregando... 0%", Font = Theme.Font, TextSize = 14, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 284), Size = UDim2.new(1, -28, 0, 30), Parent = card,
	})

	local skipBtn = create("TextButton", {
		Text = "Ignorar »", Font = Theme.FontBold, TextSize = 14, TextColor3 = Theme.Text, AutoButtonColor = false,
		BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 40), Size = UDim2.fromOffset(110, 34), Parent = backdrop,
	}, { round(10), stroke(Theme.Accent2, 1, 0.5) })

	local skipped = false
	skipBtn.MouseButton1Click:Connect(function() skipped = true end)

	local function setProgress(p)
		p = math.clamp(p, 0, 1)
		fill.Size = UDim2.fromScale(p, 1)
		pct.Text = "Carregando... " .. math.floor(p * 100 + 0.5) .. "%"
	end

	-- carrega as folhas de quadros e o áudio
	local sheets, haveFrames = {}, false
	pcall(function()
		if not (isfile and getcustomasset) then return end
		for i = 1, SHEET_COUNT do
			local f = SHEET_PREFIX .. i .. ".jpg"
			if not isfile(f) then return end
			sheets[i] = getcustomasset(f)
		end
		haveFrames = true
	end)
	local sound
	pcall(function()
		if isfile and getcustomasset and isfile(AUDIO_FILE) then
			sound = Instance.new("Sound")
			sound.SoundId = getcustomasset(AUDIO_FILE)
			sound.Volume = 1
			sound.Looped = false
			sound.Parent = sg
		end
	end)

	-- pré-carrega as imagens/áudio para não travar no meio
	if haveFrames then
		pct.Text = "Carregando vídeo..."
		local list = {}
		for i = 1, SHEET_COUNT do
			list[#list + 1] = create("ImageLabel", {
				Size = UDim2.fromOffset(2, 2), Image = sheets[i], BackgroundTransparency = 1, ImageTransparency = 0.99,
				Parent = card,
			})
		end
		if sound then list[#list + 1] = sound end
		-- PreloadAsync pode travar com arquivos locais: roda em segundo plano e nunca espera por ele
		task.spawn(function()
			pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end)
		end)
		task.wait(1.2)
	else
		frame.Visible = false
		zrp.Visible = true
		zrp.TextSize = 24
		zrp.Text = "ZRP\n(arquivos do vídeo não encontrados)"
	end

	-- toca: o carregamento só termina quando o vídeo acabar inteiro (ou ao apertar Ignorar)
	local PER = COLS * ROWS
	local t0, progress, curSheet = os.clock(), 0, 0
	if sound then pcall(function() sound:Play() end) end
	while not Hub.Destroyed and not skipped do
		task.wait()
		local el = os.clock() - t0
		progress = el / DURATION
		if haveFrames then
			local idx = math.min(FRAMES - 1, math.floor(el * FPS))
			local sh = math.floor(idx / PER) + 1
			local k = idx % PER
			if sh ~= curSheet then
				curSheet = sh
				frame.Image = sheets[sh]
			end
			frame.ImageRectOffset = Vector2.new((k % COLS) * FRAME_W, math.floor(k / COLS) * FRAME_H)
		end
		if el >= DURATION then break end
		setProgress(progress)
	end

	if Hub.Destroyed then return end

	-- terminou (ou o jogador apertou Ignorar): para o áudio e conclui a barra
	if sound then pcall(function() sound:Stop() end) end
	if skipped then
		local from = math.clamp(progress, 0, 1)
		local t1 = os.clock()
		while os.clock() - t1 < 0.4 and not Hub.Destroyed do
			task.wait()
			setProgress(from + (1 - from) * ((os.clock() - t1) / 0.4))
		end
	end
	setProgress(1)
	pct.Text = "Carregado!"
	frame.Visible = false
	zrp.TextSize = 72
	zrp.Text = "ZRP"
	zrp.Visible = true
	skipBtn.Visible = false
	task.wait(skipped and 0.5 or 1.3)

	pcall(function() sg:Destroy() end)
end

