-- Utilitários de GUI por texto (auras, níveis, raids, loja)
--==================================================================
local CAN_HIDDEN = getconnections ~= nil
local function cleanLower(t) return ((t or ""):gsub("<[^>]+>", "")):lower() end

function Utils.textOf(g)
	local t = {}
	if (g:IsA("TextButton") or g:IsA("TextLabel")) and g.Text ~= "" then t[#t + 1] = g.Text end
	for _, d in ipairs(g:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then t[#t + 1] = d.Text end
	end
	return cleanLower(table.concat(t, " "))
end

function Utils.badPath(node)
	if Hub.Gui and node:IsDescendantOf(Hub.Gui) then return true end
	local cur = node
	while cur and cur ~= game do
		local l = cur.Name:lower()
		if l == "templates" or l:find("robux") or l:find("premium") or l:find("gamepass") then return true end
		cur = cur.Parent
	end
	return false
end

local textCache = setmetatable({}, { __mode = "k" })
local badCache = setmetatable({}, { __mode = "k" })
local function badCached(g)
	local c = badCache[g]
	if not c or os.clock() - c.t > 10 then
		c = { v = Utils.badPath(g), t = os.clock() }
		badCache[g] = c
	end
	return c.v
end
function Utils.buttons(allowHidden)
	local out = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return out end
	for _, g in ipairs(pg:GetDescendants()) do
		if g:IsA("GuiButton") and not badCached(g) then
			local shown = Utils.shown(g)
			if shown or (allowHidden and CAN_HIDDEN) then
				local c = textCache[g]
				if not (c and os.clock() - c.t < 0.8) then
					c = { text = Utils.textOf(g), t = os.clock() }
					textCache[g] = c
				end
				out[#out + 1] = { btn = g, text = c.text, shown = shown }
			end
		end
	end
	return out
end

function Utils.parsePrice(text)
	local num, unit = text:match("%$%s*([%d%.,]+)%s*(%a*)")
	if not num then return nil end
	num = tonumber((num:gsub(",", "")))
	if not num then return nil end
	return num * (INCOME_UNITS[unit:lower()] or 1)
end

-- Seu dinheiro: contador do canto inferior esquerdo (melhor esforço; nil se não achar)
local moneyAt, moneyV = 0, nil
function Utils.money()
	if os.clock() - moneyAt < 1 then return moneyV end
	moneyAt = os.clock()
	moneyV = nil
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	if pg then
		Utils.startTracking()
		for g in pairs(Tracked.texts) do
			if g:IsA("TextLabel") and g.Text:find("%$") and Utils.shown(g) and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
				local t = cleanLower(g.Text):gsub("%s", "")
				if t:match("^%$[%d%.,]+%a*$") then
					local p = g.AbsolutePosition
					if p.X < vp.X * 0.35 and p.Y > vp.Y * 0.6 then
						moneyV = Utils.parsePrice(t)
						break
					end
				end
			end
		end
	end
	return moneyV
end

function Utils.scrollInto(btn)
	local sf = btn:FindFirstAncestorOfClass("ScrollingFrame")
	if not (sf and Utils.shown(btn)) then return end
	local top, by = sf.AbsolutePosition.Y, btn.AbsolutePosition.Y
	if by < top or by + btn.AbsoluteSize.Y > top + sf.AbsoluteSize.Y then
		local target = sf.CanvasPosition.Y + (by - top) - (sf.AbsoluteSize.Y - btn.AbsoluteSize.Y) / 2
		sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, math.max(0, target))
		task.wait(0.1)
	end
end

