local CAN_HIDDEN = getconnections ~= nil
local function cleanLower(t) return ((t or ""):gsub("<[^>]+>", "")):lower() end

-- texto do próprio objeto + de todos os filhos
function Utils.textOf(g)
	local t = {}
	if (g:IsA("TextButton") or g:IsA("TextLabel")) and g.Text ~= "" then t[#t + 1] = g.Text end
	for _, d in ipairs(g:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then t[#t + 1] = d.Text end
	end
	return cleanLower(table.concat(t, " "))
end

-- Templates (clonados pelo jogo), Robux, Premium e Gamepass nunca entram
function Utils.badPath(node)
	if Hub.Gui and node:IsDescendantOf(Hub.Gui) then return true end
	local cur = node
	while cur and cur ~= game do
		local l = cur.Name:lower()
		if l == "templates" or l:find("robux") or l:find("premium") or l:find("gamepass") then return true end
		cur = cur.Parent
	end
	return false
end

local textCache = setmetatable({}, { __mode = "k" })
-- Todos os botões da GUI: { btn, text, shown }. Com allowHidden, inclui painéis fechados (se o executor tem getconnections).
function Utils.buttons(allowHidden)
	local out = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return out end
	for _, g in ipairs(pg:GetDescendants()) do
		if g:IsA("GuiButton") and not Utils.badPath(g) then
			local shown = Utils.shown(g)
			if shown or (allowHidden and CAN_HIDDEN) then
				local c = textCache[g]
				if not (c and os.clock() - c.t < 0.8) then
					c = { text = Utils.textOf(g), t = os.clock() }
					textCache[g] = c
				end
				out[#out + 1] = { btn = g, text = c.text, shown = shown }
			end
		end
	end
	return out
end

-- "$1.78B" / "$11.2T" -> número
function Utils.parsePrice(text)
	local num, unit = text:match("%$%s*([%d%.,]+)%s*(%a*)")
	if not num then return nil end
	num = tonumber((num:gsub(",", "")))
	if not num then return nil end
	return num * (INCOME_UNITS[unit:lower()] or 1)
end

-- Seu dinheiro: lê o contador do canto inferior esquerdo da tela (melhor esforço; nil se não achar)
local moneyAt, moneyV = 0, nil
function Utils.money()
	if os.clock() - moneyAt < 1 then return moneyV end
	moneyAt = os.clock()
	moneyV = nil
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	if pg then
		for _, g in ipairs(pg:GetDescendants()) do
			if g:IsA("TextLabel") and g.Text:find("%$") and Utils.shown(g) and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
				local t = cleanLower(g.Text):gsub("%s", "")
				if t:match("^%$[%d%.,]+%a*$") then
					local p = g.AbsolutePosition
					if p.X < vp.X * 0.35 and p.Y > vp.Y * 0.6 then
						moneyV = Utils.parsePrice(t)
						break
					end
				end
			end
		end
	end
	return moneyV
end

function Utils.scrollInto(btn)
	local sf = btn:FindFirstAncestorOfClass("ScrollingFrame")
	if not (sf and Utils.shown(btn)) then return end
	local top, by = sf.AbsolutePosition.Y, btn.AbsolutePosition.Y
	if by < top or by + btn.AbsoluteSize.Y > top + sf.AbsoluteSize.Y then
		local target = sf.CanvasPosition.Y + (by - top) - (sf.AbsoluteSize.Y - btn.AbsoluteSize.Y) / 2
		sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, math.max(0, target))
		task.wait(0.1)
	end
end

local function dumpText(title, lines)
	if #lines == 0 then lines[1] = "Nada encontrado. Abra o painel correspondente e tente de novo." end
	local text = title .. "\n" .. table.concat(lines, "\n")
	print(text)
	if setclipboard then pcall(setclipboard, text) end
	Notifications.Push(title, #lines .. " linhas" .. (setclipboard and " copiadas." or " no console."))
end

-- Prioridade entre funções que disputam o mesmo alvo: Raid > Fendas > Talk/Coleta
function Utils.takeOver(id, keywords)
	if Lock.target and Lock.id ~= id and Lock.id ~= "raid" and not Mini.active and not Utils.findBeg()
		and Utils.pickTarget(keywords, nil, false) then
		release()
	end
end

-- Prompt do "pad" do centro da raid: o mais próximo de você (ignora NPCs/lojas). Usado logo após viajar.
local PAD_BAD = { "shop", "loja", "robux", "store", "premium", "gamepass" }
function Utils.firePad(radius)
	if not fireproximityprompt then return false end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local best, bd
	for p in pairs(Prompts) do
		if p.Enabled and p:IsDescendantOf(workspace) and not Utils.isBlacklisted(p) and not npcPrompt(p) then
			local txt = (p.ObjectText .. " " .. p.ActionText .. " " .. p:GetFullName()):lower()
			local part = p.Parent
			if part and part:IsA("Attachment") then part = part.Parent end
			if part and part:IsA("BasePart") and not matches(txt, PAD_BAD) then
				local d = (hrp.Position - part.Position).Magnitude
				if d <= radius and (not bd or d < bd) then best, bd = p, d end
			end
		end
	end
	if not best then return false end
	pcall(function()
		best.HoldDuration = 0
		best.RequiresLineOfSight = false
	end)
	Utils.wakeKeyboard()
	fireproximityprompt(best)
	return true, best
end

