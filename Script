Modules.Upgrades = { Name = "Upgrades", Icon = "⬆️", Init = function(page)
	page:Section("Upgrades")
	local blocked = {}
	Feature(page, "upgrade_all", "Auto Upgrade All Characters",
		"Percorre a pasta de personagens e envia upgrade; o servidor decide se há recursos.", 1, function()
			local folder = Utils.need("upgrade_all", "CharacterFolder")
			local remote = Utils.need("upgrade_all", "UpgradeRemote")
			if not (folder and remote) then return end
			for _, ch in ipairs(folder:GetChildren()) do
				if not Toggles.Active("upgrade_all") then break end
				if not (blocked[ch] and os.clock() < blocked[ch]) then
					local res = Utils.call(remote, Configuration.Builders.Upgrade(ch))
					blocked[ch] = os.clock() + (res == false and 30 or Configuration.UpgradeCooldown)
					task.wait(0.05)
				end
			end
		end)

	page:Section("Níveis dos personagens (Mochila aberta)")
	local UP_ONE = { "subir de n", "level up", "upgrade", "melhorar" }
	local function detailBtn(mode)
		for _, e in ipairs(Utils.buttons(false)) do
			local t = e.text
			local isMax = t:match("^%s*max") ~= nil
			if Utils.parsePrice(t) then
				if mode == "max" and isMax then return e end
				if mode == "one" and not isMax and matches(t, UP_ONE) then return e end
			end
		end
		return nil
	end
	-- cartões dos personagens na Mochila: botões dentro de um ScrollingFrame que mostram "$xxx/s"
	local function cards()
		local out = {}
		for _, e in ipairs(Utils.buttons(false)) do
			if e.btn:FindFirstAncestorOfClass("ScrollingFrame") and parseIncome(e.text) then
				table.insert(out, e.btn)
			end
		end
		table.sort(out, function(a, b)
			local pa, pb = a.AbsolutePosition, b.AbsolutePosition
			if math.abs(pa.Y - pb.Y) > 4 then return pa.Y < pb.Y end
			return pa.X < pb.X
		end)
		return out
	end
	local warnedBag = 0
	local function levelPass(id, mode)
		local list = cards()
		if #list == 0 then
			if os.clock() - warnedBag > 15 then
				warnedBag = os.clock()
				Notifications.Push("Upgrade", "Abra a Mochila (aba Baddies) para eu enxergar os personagens.", "warn")
			end
			return
		end
		for _, card in ipairs(list) do
			if not Toggles.Active(id) then return end
			if card.Parent then
				Utils.scrollInto(card)
				Utils.clickGui(card)
				task.wait(Configuration.LevelSelectWait)
				local e = detailBtn(mode)
				if e then
					local price, money = Utils.parsePrice(e.text), Utils.money()
					if not (price and money and price > money) then
						Utils.clickGui(e.btn)
						task.wait(0.2)
					end
				end
			end
		end
	end
	Feature(page, "level_one", "Auto Subir 1 Nível (todos)",
		"Com a Mochila aberta: seleciona cada personagem e aperta 'Subir de Nível' uma vez.", 2, function()
			levelPass("level_one", "one")
		end)
	Feature(page, "level_max", "Auto Subir ao Máximo (todos)",
		"Com a Mochila aberta: seleciona cada personagem e aperta 'Max' (o máximo que o dinheiro permite).", 3, function()
			levelPass("level_max", "max")
		end)
	page:Button("Escanear Mochila (cartões e botões de nível)", function()
		local out = {}
		local c = cards()
		table.insert(out, "Cartões encontrados: " .. #c)
		for i = 1, math.min(5, #c) do table.insert(out, "  cartão: " .. c[i]:GetFullName()) end
		for _, mode in ipairs({ "one", "max" }) do
			local e = detailBtn(mode)
			table.insert(out, mode .. ": " .. (e and (e.text:sub(1, 40) .. " | " .. e.btn:GetFullName()) or "não achei (selecione um personagem)"))
		end
		table.insert(out, "Dinheiro lido: " .. tostring(Utils.money()))
		dumpText("Scan da Mochila", out)
	end)
end }

Modules.Shop = { Name = "Loja", Icon = "🛒", Init = function(page)
	page:Section("Loja")
	-- 100% automático: não precisa de caminho nenhum. Procura as lojas de poções/venenos na GUI do jogo
	-- (aberta OU fechada, se o executor tiver getconnections), ignora Robux e estrelas/gemas e compra com o dinheiro do jogo.
	local SHOP_WORDS = { "poç", "pocao", "potion", "venen", "poison", "loja", "shop", "store" }
	local BUY_WORDS = { "buy", "comprar", "compra", "purchase" }
	local BAD_WORDS = { "esgotado", "sold out", "max", "bloquead", "locked", "indispon", "owned", "adquirido", "equipado" }
	local UNITS = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, o = 1e27, n = 1e30, d = 1e33 }
	local canHidden = getconnections ~= nil
	local function vis(g) return canHidden or Utils.shown(g) end

	local function clean(t) return (t:gsub("<[^>]+>", "")) end

	local function textOf(g)
		local t = {}
		if g:IsA("TextButton") and g.Text ~= "" then table.insert(t, g.Text) end
		for _, d in ipairs(g:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" and vis(d) then table.insert(t, d.Text) end
		end
		return clean(table.concat(t, " ")):lower()
	end

	local function parsePrice(text)
		local num, unit = text:match("%$%s*([%d%.,]+)%s*(%a*)")
		if not num then return nil end
		num = tonumber((num:gsub(",", "")))
		if not num then return nil end
		return num * (UNITS[unit:lower()] or 1)
	end

	local function starText(t)
		return t:find("%f[%a]stars?%f[%A]") or t:find("estrela") or t:find("%f[%a]gems?%f[%A]") or t:find("gema")
			or t:find("diamond") or t:find("diamante") or t:find("★", 1, true) or t:find("⭐", 1, true)
	end

	-- Pula pelo CAMINHO: RobuxShopPanel, Templates (modelos clonados pelo jogo), Premium, Gamepass, cartões Rx...
	local function pathSkip(node)
		local cur = node
		while cur and cur ~= game do
			local n = cur.Name
			local l = n:lower()
			if l == "templates" or l:find("robux") or l:find("premium") or l:find("gamepass")
				or n:match("^Rx%u") then
				return "caminho " .. n
			end
			cur = cur.Parent
		end
		return nil
	end

	local function skipReason(node, txt)
		local ps = pathSkip(node)
		if ps then return ps end
		if txt:find("buy all", 1, true) or txt:find("comprar tudo", 1, true) then return "comprar tudo" end
		if txt:find("r%$") or txt:find("robux") or txt:find("premium") or txt:find("gamepass") then return "Robux/premium" end
		if starText(txt) then return "estrela/gema" end
		for _, d in ipairs(node:GetDescendants()) do
			local n = d.Name:lower()
			if n:find("robux") or n:find("premium") or n:find("gamepass") then return "ícone Robux" end
		end
		local cur = node
		for _ = 1, 4 do
			if not cur then break end
			for _, f in ipairs(Configuration.SkipFlags) do
				if cur:GetAttribute(f) then return "atributo " .. f end
			end
			cur = cur.Parent
		end
		if matches(txt, BAD_WORDS) then return "indisponível" end
		return nil
	end

	-- { btn, price, text, skip }. Se o preço está no próprio botão, só ele conta (um cartão pode ter botão de dinheiro E de estrela).
	local function analyze(btn)
		local own = textOf(btn)
		local ownPrice = parsePrice(own)
		local hasBuy = matches(own, BUY_WORDS)
		if not (ownPrice or hasBuy) then return nil end
		local scopeNode, scopeText = btn, own
		if not ownPrice then
			local card = btn.Parent
			if card and card:IsA("GuiObject") and #card:GetChildren() <= 8 then
				scopeNode, scopeText = card, own .. " " .. textOf(card)
			end
		end
		return { btn = btn, price = ownPrice or parsePrice(scopeText), text = own, skip = skipReason(scopeNode, scopeText) }
	end

	-- Painel da loja = menor ancestral de um texto "poção/veneno/loja..." que tenha 2+ botões de compra.
	local function collect()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return {} end
		local memo, tried, seen, out = {}, {}, {}, {}
		local function info(btn)
			local v = memo[btn]
			if v == nil then v = analyze(btn) or false memo[btn] = v end
			return v
		end
		for _, g in ipairs(pg:GetDescendants()) do
			if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Text ~= "" and vis(g)
				and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
				local t = clean(g.Text):lower()
				local hit = false
				for _, w in ipairs(SHOP_WORDS) do
					if t:find(w, 1, true) then hit = true break end
				end
				if hit then
					local a = g.Parent
					for _ = 1, 4 do
						if not (a and a:IsA("GuiObject")) then break end
						if tried[a] == nil then
							local list = {}
							for _, d in ipairs(a:GetDescendants()) do
								if d:IsA("GuiButton") and vis(d) and not seen[d] then
									local i = info(d)
									if i then table.insert(list, i) end
								end
							end
							tried[a] = #list >= 2
							if tried[a] then
								for _, i in ipairs(list) do
									seen[i.btn] = true
									table.insert(out, i)
								end
							end
						end
						if tried[a] then break end
						a = a.Parent
					end
				end
			end
		end
		return out
	end

	local function scrollInto(btn)
		local sf = btn:FindFirstAncestorOfClass("ScrollingFrame")
		if not (sf and Utils.shown(btn)) then return end
		local top, by = sf.AbsolutePosition.Y, btn.AbsolutePosition.Y
		if by < top or by + btn.AbsoluteSize.Y > top + sf.AbsoluteSize.Y then
			local target = sf.CanvasPosition.Y + (by - top) - (sf.AbsoluteSize.Y - btn.AbsoluteSize.Y) / 2
			sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, math.max(0, target))
			task.wait(0.1)
		end
	end

	local lastBuy = setmetatable({}, { __mode = "k" })
	local announced = false
	Feature(page, "shop_gui", "Auto Buy Poções/Venenos",
		"Detecta as lojas sozinho e compra todos os itens com dinheiro do jogo. Ignora Robux e estrelas/gemas.",
		1.5, function()
			local list = {}
			for _, info in ipairs(collect()) do
				if not info.skip then table.insert(list, info) end
			end
			if #list == 0 then announced = false return end
			if not announced then
				announced = true
				Notifications.Push("Loja detectada", #list .. " itens com dinheiro do jogo.")
			end
			table.sort(list, function(a, b) return (a.price or 0) < (b.price or 0) end)
			for _, info in ipairs(list) do
				if not Toggles.Active("shop_gui") then break end
				local btn = info.btn
				if btn.Parent and os.clock() - (lastBuy[btn] or 0) >= 0.8 then
					lastBuy[btn] = os.clock()
					scrollInto(btn)
					Utils.clickGui(btn, not Utils.shown(btn)) -- loja fechada: só dispara o botão (sem clique na tela)
					task.wait(0.2)
				end
			end
		end)
	-- Auras: compra toda aura que aparecer disponível (botão de compra/preço dentro do painel de Auras)
	local AURA_BUY = { "buy", "comprar", "compra", "purchase", "unlock", "desbloquear", "obter" }
	local AURA_BAD = { "equip", "renascimento", "rebirth", "robux", "r$", "buy all", "comprar tudo", "esgotado", "sold out" }
	local lastAura = setmetatable({}, { __mode = "k" })
	local function auraButtons()
		local out = {}
		for _, e in ipairs(Utils.buttons(true)) do
			local t = e.text
			local price = Utils.parsePrice(t)
			if (price or matches(t, AURA_BUY)) and not matches(t, AURA_BAD) and not starText(t) then
				local scope, ok = e.btn.Parent, false
				for _ = 1, 3 do
					if scope and scope:IsA("GuiObject") then
						local st = Utils.textOf(scope)
						if st:find("aura", 1, true) and not st:find("poç", 1, true) and not st:find("venen", 1, true) then ok = true break end
						scope = scope.Parent
					end
				end
				if ok then
					e.price = price
					table.insert(out, e)
				end
			end
		end
		return out
	end
	Feature(page, "shop_aura", "Auto Buy Auras",
		"Compra toda aura que ficar disponível (ignora Robux, estrelas e as bloqueadas por Renascimento).", 2, function()
			local money = Utils.money()
			for _, e in ipairs(auraButtons()) do
				if not Toggles.Active("shop_aura") then break end
				local btn = e.btn
				if btn.Parent and os.clock() - (lastAura[btn] or 0) >= 2 and not (e.price and money and e.price > money) then
					lastAura[btn] = os.clock()
