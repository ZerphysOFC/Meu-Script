Modules.Movement = { Name = "Movimento", Icon = "🧭", Init = function(page)
	local beat = nil
	local sync

	page:Section("Ir até o personagem")
	page:Toggle("moveto", "Ir até o personagem",
		"Já vem ligado: voa até o Baddie escolhido automaticamente. Modo (voando/andando) e velocidade ficam em Config. Autofarm > Movimento.", true)

	local function step(dt)
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local t = Utils.currentTarget()
		if not t then return end
		local goal, stop = t.part.Position, math.max(3, t.prompt.MaxActivationDistance * 0.7)
		local to = goal - hrp.Position
		hrp.AssemblyLinearVelocity = Vector3.zero
		if to.Magnitude <= stop then return end
		local len = math.min(to.Magnitude - stop, Configuration.FlySpeed * dt)
		hrp.CFrame = CFrame.new(hrp.Position + to.Unit * len) * (hrp.CFrame - hrp.CFrame.Position)
	end

	function sync()
		local want = Toggles.Active("moveto") and Configuration.MoveMode == "fly" and not Hub.Destroyed
		if want and not beat then
			beat = RunService.Heartbeat:Connect(function(dt)
				local ok, err = pcall(step, dt)
				if not ok then
					Utils.softError("Voo", err)
				end
			end)
		elseif not want and beat then
			beat:Disconnect()
			beat = nil
		end
	end
	Hub.SyncMove = sync
	Toggles.Listen(sync)
	table.insert(Hub.Cleanup, { Destroy = function() if beat then beat:Disconnect() beat = nil end end })
	sync()
end }

