local BlackCache = setmetatable({}, { __mode = "k" })

local function blackText(p)
	local parts = { p.ObjectText, p.ActionText, p:GetFullName() }
	local model = p:FindFirstAncestorOfClass("Model")
	if model then
		table.insert(parts, model.Name)
		for _, v in pairs(model:GetAttributes()) do
			if type(v) == "string" then table.insert(parts, v) end
		end
		for _, d in ipairs(model:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
				table.insert(parts, d.Text)
			end
		end
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if pg then
			for _, b in ipairs(pg:GetChildren()) do
				if b:IsA("BillboardGui") and b.Adornee and b.Adornee:IsDescendantOf(model) then
					for _, d in ipairs(b:GetDescendants()) do
						if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
							table.insert(parts, d.Text)
						end
					end
				end
			end
		end
	end
	return (table.concat(parts, " | "):gsub("<[^>]+>", "")):lower()
end

function Utils.isBlacklisted(p)
	local list = Configuration.Blacklist
	if not list or #list == 0 then return false end
	local c = BlackCache[p]
	if not c or os.clock() - c.t > 15 then
		c = { text = blackText(p), t = os.clock() }
		BlackCache[p] = c
	end
	for _, w in ipairs(list) do
		if w ~= "" and c.text:find(w, 1, true) then return true end
	end
	return false
end

--==================================================================
-- Raridade
--==================================================================
local RarityCache = setmetatable({}, { __mode = "k" })

local function rankFromText(text)
	text = text:lower()
	local bestIdx, bestLen
	for i, name in ipairs(Configuration.RarityOrder) do
		local n = name:lower()
		if text:find("%f[%a]" .. n:gsub("%p", "%%%0") .. "%f[%A]") and (not bestLen or #n > bestLen) then
			bestIdx, bestLen = i, #n
		end
	end
	return bestIdx
end

local function exactRank(text)
	local t = text:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", ""):lower()
	for i, name in ipairs(Configuration.RarityOrder) do
		if t == name:lower() then return i end
	end
	return nil
end

local INCOME_UNITS = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, o = 1e27, n = 1e30, d = 1e33 }
local function parseIncome(text)
	local num, unit = text:match("%$%s*([%d%.,]+)%s*(%a*)%s*/%s*[sS]")
	if not num then return nil end
	num = tonumber((num:gsub(",", "")))
	if not num then return nil end
	return num * (INCOME_UNITS[unit:lower()] or 1)
end

function Utils.rarityInfo(p)
	local c = RarityCache[p]
	if c and ((c.rank and c.income > 0) or os.clock() - c.t < (c.rank and 20 or 5)) then return c.rank, c.income end
	local rank
	local node = p
	for _ = 1, 6 do
		if not node or node == workspace then break end
		local v = node:GetAttribute(Configuration.RarityKey)
		if v == nil then
			local ch = node:FindFirstChild(Configuration.RarityKey)
			if ch and ch:IsA("ValueBase") then v = ch.Value end
		end
		if v ~= nil then
			rank = (type(v) == "number") and v or (rankFromText(tostring(v)) or 0)
			break
		end
		local ex = exactRank(node.Name)
		if ex then
			rank = ex
			break
		end
		node = node.Parent
	end
	if not rank then rank = rankFromText(p.ObjectText .. " " .. p.ActionText) end
	local scanRank = (rank == nil)
	local income = parseIncome(p.ObjectText .. " " .. p.ActionText) or 0
	local exact = false
	local model = p:FindFirstAncestorOfClass("Model")
	local function consider(d)
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			local txt = d.Text
			if scanRank and not exact then
				local ex = exactRank(txt)
				if ex then
					rank, exact = ex, true
				else
					local r = rankFromText(txt)
					if r and (not rank or r > rank) then rank = r end
				end
			end
			local inc = parseIncome(txt)
			if inc and inc > income then income = inc end
		end
	end
	if model then
		if scanRank then
			for _, v in pairs(model:GetAttributes()) do
				if type(v) == "string" then
					local r = exactRank(v) or rankFromText(v)
					if r and (not rank or r > rank) then rank = r end
				end
			end
		end
		for _, d in ipairs(model:GetDescendants()) do consider(d) end
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if pg then
			for _, b in ipairs(pg:GetChildren()) do
				if b:IsA("BillboardGui") and b.Adornee and b.Adornee:IsDescendantOf(model) then
					for _, d in ipairs(b:GetDescendants()) do consider(d) end
				end
			end
		end
	end
	RarityCache[p] = { rank = rank, income = income, t = os.clock() }
	return rank, income
end

