function Configuration.Save()
	if not writefile then return false end
	local ok = pcall(function()
		writefile(FILE, HttpService:JSONEncode({
			Paths = Configuration.Paths, Speed = Configuration.Speed,
			Intervals = Configuration.Intervals, PerfectKey = Configuration.PerfectKey,
			MoveMode = Configuration.MoveMode, FlySpeed = Configuration.FlySpeed,
			Blacklist = Configuration.Blacklist, RaidDifficulty = Configuration.RaidDifficulty,
			AutoCloseDialog = Configuration.AutoCloseDialog,
			Pinned = Configuration.Pinned, WinPos = Configuration.WinPos, IconId = Configuration.IconId,
			Tunables = (function()
				local t = {}
				for _, k in ipairs(Configuration.TunableKeys) do t[k] = Configuration[k] end
				return t
			end)(),
			RarityFilter = (function()
				local l = {}
				for k in pairs(Configuration.RarityFilter) do l[#l + 1] = k end
				return l
			end)(),
		}))
	end)
	return ok
end
function Configuration.Load()
	if not (readfile and isfile and isfile(FILE)) then return end
	pcall(function()
		local d = HttpService:JSONDecode(readfile(FILE))
		for k, v in pairs(d.Paths or {}) do Configuration.Paths[k] = v end
		Configuration.Speed = d.Speed or 1
		Configuration.Intervals = d.Intervals or {}
		local known = {}
		for _, n in ipairs(Configuration.RarityOrder) do known[n:lower()] = true end
		for _, k in ipairs(d.RarityFilter or {}) do
			if known[k] then Configuration.RarityFilter[k] = true end
		end
		if type(d.Tunables) == "table" then
			for _, k in ipairs(Configuration.TunableKeys) do
				local v = tonumber(d.Tunables[k])
				if v then Configuration[k] = v end
			end
		end
		if d.MoveMode == "walk" or d.MoveMode == "fly" then Configuration.MoveMode = d.MoveMode end
		Configuration.FlySpeed = tonumber(d.FlySpeed) or Configuration.FlySpeed
		Configuration.Pinned = d.Pinned == true
		if type(d.AutoCloseDialog) == "boolean" then Configuration.AutoCloseDialog = d.AutoCloseDialog end
		if type(d.WinPos) == "table" and tonumber(d.WinPos.x) and tonumber(d.WinPos.y) then
			Configuration.WinPos = { x = tonumber(d.WinPos.x), y = tonumber(d.WinPos.y) }
		end
		if type(d.IconId) == "string" then
			local id = d.IconId:gsub("%D", "")
			Configuration.IconId = id
		end
		if d.RaidDifficulty == "easy" or d.RaidDifficulty == "normal" or d.RaidDifficulty == "hard" then
			Configuration.RaidDifficulty = d.RaidDifficulty
		end
		if type(d.Blacklist) == "table" then
			local l = {}
			for _, w in ipairs(d.Blacklist) do
				if type(w) == "string" and w ~= "" and w:lower() ~= "recruiter" then l[#l + 1] = w:lower() end
			end
			Configuration.Blacklist = l
		end
		-- config antiga salvava só "Click": ignora e usa o novo padrão
		local pk = d.PerfectKey
		if type(pk) == "string" and pk ~= "" and pk:lower() ~= "click" then Configuration.PerfectKey = pk end
	end)
end
Configuration.Load()

