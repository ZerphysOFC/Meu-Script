local function matches(text, words)
	for _, w in ipairs(words) do
		if #w <= 3 then
			if text:find("%f[%a]" .. w:gsub("%p", "%%%0") .. "%f[%A]") then return true end
		elseif text:find(w, 1, true) then
			return true
		end
	end
	return false
end

