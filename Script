		AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.X, Parent = host,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local subs = {}
	local function pick(sub)
		for _, s in ipairs(subs) do
			s.Frame.Visible = (s == sub)
			tween(s.TabBtn, 0.15, { BackgroundColor3 = (s == sub) and Theme.Accent or Theme.Card })
		end
	end
	local function tab(name)
		local sub = newSub(host)
		sub.TabBtn = create("TextButton", {
			Text = name, Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text, AutoButtonColor = false,
			AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), BackgroundColor3 = Theme.Card,
			LayoutOrder = #subs + 1, Parent = bar,
		}, { round(8), create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
		connect(sub.TabBtn.MouseButton1Click, function() pick(sub) end)
		table.insert(subs, sub)
