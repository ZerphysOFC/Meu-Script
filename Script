local function T(key) return Configuration[key] / math.max(0.25, Configuration.Speed) end

function Configuration.ApplySpeed()
	if Configuration.SpeedMode == "custom" then
		Configuration.Speed = Configuration.CustomSpeed
	else
		Configuration.Speed = SPEEDS[Configuration.SpeedMode] or 1
	end
end

-- Arquivo: { Saves = { [nome] = {...} }, AutoLoad = nome, Global = { Pinned, WinPos, IconId, WallDim, WallId } }
local function readDB()
	local db
	if readfile and isfile and isfile(FILE) then
		pcall(function() db = HttpService:JSONDecode(readfile(FILE)) end)
	end
	if type(db) ~= "table" then db = {} end
	if type(db.Saves) ~= "table" then db.Saves = {} end
	if type(db.Global) ~= "table" then db.Global = {} end
	return db
end
local function writeDB(db)
	if not writefile then return false end
	return (pcall(function() writefile(FILE, HttpService:JSONEncode(db)) end))
end

function Configuration.SaveGlobal()
	local db = readDB()
	db.Global = {
		Pinned = Configuration.Pinned, WinPos = Configuration.WinPos, IconId = Configuration.IconId,
		WallDim = Configuration.WallDim, WallId = Configuration.WallId,
	}
	writeDB(db)
end

do
	local g = readDB().Global
	Configuration.Pinned = g.Pinned == true
	if type(g.WinPos) == "table" and tonumber(g.WinPos.x) and tonumber(g.WinPos.y) then
		Configuration.WinPos = { x = tonumber(g.WinPos.x), y = tonumber(g.WinPos.y) }
	end
	if type(g.IconId) == "string" then Configuration.IconId = (g.IconId:gsub("%D", "")) end
	if tonumber(g.WallDim) then Configuration.WallDim = math.clamp(tonumber(g.WallDim), 0, 0.95) end
	if type(g.WallId) == "string" then Configuration.WallId = (g.WallId:gsub("%D", "")) end
end

function Configuration.Snapshot()
	local rf, tg, nf = {}, {}, {}
	for k in pairs(Configuration.RarityFilter) do rf[#rf + 1] = k end
	for k in pairs(Configuration.NotifyFilter) do nf[#nf + 1] = k end
	for id, v in pairs(Toggles.State) do
		if id ~= "master" and id ~= "rarest" then tg[id] = v == true end
	end
	return {
		SpeedMode = Configuration.SpeedMode, CustomSpeed = Configuration.CustomSpeed,
		MoveMode = Configuration.MoveMode, RaidDifficulty = Configuration.RaidDifficulty,
		StrictRarity = Configuration.StrictRarity, RarityFilter = rf, NotifyFilter = nf, Toggles = tg,
		FarmZone = Configuration.FarmZone or "none",
	}
end

function Configuration.Apply(s)
	if type(s) ~= "table" then return end
	if s.SpeedMode == "custom" or SPEEDS[s.SpeedMode] then Configuration.SpeedMode = s.SpeedMode end
	Configuration.CustomSpeed = math.clamp(tonumber(s.CustomSpeed) or Configuration.CustomSpeed, 0.5, 10)
	Configuration.ApplySpeed()
	if s.MoveMode == "walk" or s.MoveMode == "fly" then Configuration.MoveMode = s.MoveMode end
	if s.FarmZone == "none" then
		Configuration.FarmZone = nil
	elseif s.FarmZone == "mercado" or s.FarmZone == "floresta" or s.FarmZone == "castelo" then
		Configuration.FarmZone = s.FarmZone
	end
	if s.RaidDifficulty == "easy" or s.RaidDifficulty == "normal" or s.RaidDifficulty == "hard" then
		Configuration.RaidDifficulty = s.RaidDifficulty
	end
	if type(s.StrictRarity) == "boolean" then Configuration.StrictRarity = s.StrictRarity end
	for k in pairs(Configuration.RarityFilter) do Configuration.RarityFilter[k] = nil end
	local known = {}
	for _, n in ipairs(Configuration.RarityOrder) do known[n:lower()] = true end
	for _, k in ipairs(s.RarityFilter or {}) do
		if known[k] then Configuration.RarityFilter[k] = true end
	end
	for k in pairs(Configuration.NotifyFilter) do Configuration.NotifyFilter[k] = nil end
	for _, k in ipairs(s.NotifyFilter or {}) do
		if known[k] then Configuration.NotifyFilter[k] = true end
	end
	if type(s.Toggles) == "table" then
		for id, v in pairs(s.Toggles) do
			if Toggles.State[id] ~= nil and id ~= "master" and id ~= "rarest" then Toggles.Set(id, v == true) end
		end
	end
	if Hub.SyncMove then Hub.SyncMove() end
	if Hub.Refresh then Hub.Refresh() end
end

function Configuration.SaveAs(name)
	local db = readDB()
	db.Saves[name] = Configuration.Snapshot()
	return writeDB(db)
end
function Configuration.LoadSave(name)
	local s = readDB().Saves[name]
	if not s then return false end
	Configuration.Apply(s)
	return true
end
function Configuration.SetAutoLoad(name)
	local db = readDB()
	db.AutoLoad = name
	return writeDB(db)
end

