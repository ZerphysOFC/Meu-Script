				Position = UDim2.fromOffset(32, 0), Size = UDim2.new(0.5, 0, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Left, Parent = btn,
			})
			local state = create("TextLabel", {
				Text = "", Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.Text, BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(110, 20),
				TextXAlignment = Enum.TextXAlignment.Right, Parent = btn,
			})
			local function paint()
				local on = filter[key]
				tween(btn, 0.15, { BackgroundColor3 = on and Theme.Accent or Theme.Bg })
				state.Text = on and "✔ MARCADA" or "—"
			end
