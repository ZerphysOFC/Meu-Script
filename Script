local BlackCache = setmetatable({}, { __mode = "k" })

local function blackText(p)
	local parts = { p.ObjectText, p.ActionText, p:GetFullName() }
	local model = p:FindFirstAncestorOfClass("Model")
	if model then
		table.insert(parts, model.Name)
		for _, v in pairs(model:GetAttributes()) do
			if type(v) == "string" then table.insert(parts, v) end
		end
		for _, d in ipairs(model:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
				table.insert(parts, d.Text)
			end
		end
		-- placas (BillboardGui) que ficam no PlayerGui apontando para o modelo
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if pg then
			for _, b in ipairs(pg:GetChildren()) do
				if b:IsA("BillboardGui") and b.Adornee and b.Adornee:IsDescendantOf(model) then
					for _, d in ipairs(b:GetDescendants()) do
						if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
							table.insert(parts, d.Text)
						end
					end
				end
			end
		end
	end
	return (table.concat(parts, " | "):gsub("<[^>]+>", "")):lower()
end

function Utils.isBlacklisted(p)
	local list = Configuration.Blacklist
	if not list or #list == 0 then return false end
	local c = BlackCache[p]
	if not c or os.clock() - c.t > 5 then
		c = { text = blackText(p), t = os.clock() }
		BlackCache[p] = c
	end
	for _, w in ipairs(list) do
		if w ~= "" and c.text:find(w, 1, true) then return true end
	end
	return false
end

-- Raridade
local RarityCache = setmetatable({}, { __mode = "k" })

local function rankFromText(text)
	text = text:lower()
	local bestIdx, bestLen
	for i, name in ipairs(Configuration.RarityOrder) do
		local n = name:lower()
		if text:find("%f[%a]" .. n:gsub("%p", "%%%0") .. "%f[%A]") and (not bestLen or #n > bestLen) then
			bestIdx, bestLen = i, #n
		end
	end
	return bestIdx
end

-- texto inteiro igual a um nome de raridade (ex.: "Legendary")
local function exactRank(text)
	local t = text:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", ""):lower()
	for i, name in ipairs(Configuration.RarityOrder) do
		if t == name:lower() then return i end
	end
	return nil
end

local INCOME_UNITS = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, o = 1e27, n = 1e30, d = 1e33 }
local function parseIncome(text)
	local num, unit = text:match("%$%s*([%d%.,]+)%s*(%a*)%s*/%s*[sS]")
	if not num then return nil end
	num = tonumber((num:gsub(",", "")))
	if not num then return nil end
	return num * (INCOME_UNITS[unit:lower()] or 1)
end

-- Devolve (raridade, renda/s). Raridade: Attribute/Value -> texto do prompt -> textos do personagem.
-- Renda: o "+$240,000/s" que aparece sobre o personagem (quanto maior, mais raro).
function Utils.rarityInfo(p)
	local c = RarityCache[p]
	if c and ((c.rank and c.income > 0) or os.clock() - c.t < 4) then return c.rank, c.income end
	local rank
	local node = p
	for _ = 1, 6 do
		if not node or node == workspace then break end
		local v = node:GetAttribute(Configuration.RarityKey)
		if v == nil then
			local ch = node:FindFirstChild(Configuration.RarityKey)
			if ch and ch:IsA("ValueBase") then v = ch.Value end
		end
		if v ~= nil then
			rank = (type(v) == "number") and v or (rankFromText(tostring(v)) or 0)
			break
		end
		local ex = exactRank(node.Name)
		if ex then
			rank = ex
			break
		end
		node = node.Parent
	end
	if not rank then rank = rankFromText(p.ObjectText .. " " .. p.ActionText) end
	local scanRank = (rank == nil)
	local income = parseIncome(p.ObjectText .. " " .. p.ActionText) or 0
	local exact = false
	local model = p:FindFirstAncestorOfClass("Model")
	local function consider(d)
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			local txt = d.Text
			if scanRank and not exact then
				local ex = exactRank(txt)
				if ex then
					rank, exact = ex, true
				else
					local r = rankFromText(txt)
					if r and (not rank or r > rank) then rank = r end
				end
			end
			local inc = parseIncome(txt)
			if inc and inc > income then income = inc end
		end
	end
	if model then
		if scanRank then
			for _, v in pairs(model:GetAttributes()) do
				if type(v) == "string" then
					local r = exactRank(v) or rankFromText(v)
					if r and (not rank or r > rank) then rank = r end
				end
			end
		end
		for _, d in ipairs(model:GetDescendants()) do consider(d) end
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if pg then
			for _, b in ipairs(pg:GetChildren()) do
				if b:IsA("BillboardGui") and b.Adornee and b.Adornee:IsDescendantOf(model) then
					for _, d in ipairs(b:GetDescendants()) do consider(d) end
				end
			end
		end
	end
	RarityCache[p] = { rank = rank, income = income, t = os.clock() }
	return rank, income
end

function Utils.rarityRank(p)
	local r = Utils.rarityInfo(p)
	return r
end

-- Visível de verdade?
function Utils.shown(g)
	while g and g ~= game do
		if g:IsA("GuiObject") and not g.Visible then return false end
		if g:IsA("LayerCollector") and not g.Enabled then return false end
		g = g.Parent
	end
	return true
end

local function isRedColor(c) return c.R > 0.6 and c.G < 0.32 and c.B < 0.5 and (c.R - c.G) > 0.4 end

-- Considera a cor base multiplicada pelo UIGradient (muitos jogos pintam com gradiente)
local function tinted(base, g)
	local gr = g:FindFirstChildOfClass("UIGradient")
	if gr then
		local kp = gr.Color.Keypoints
		local k = kp[math.ceil(#kp / 2)].Value
		return Color3.new(base.R * k.R, base.G * k.G, base.B * k.B)
	end
	return base
end

function Utils.isRed(g)
	if g.BackgroundTransparency < 0.9 and isRedColor(tinted(g.BackgroundColor3, g)) then return true end
	if (g:IsA("ImageLabel") or g:IsA("ImageButton")) and g.ImageTransparency < 0.9
		and isRedColor(tinted(g.ImageColor3, g)) then
		return true
	end
	return false
end

-- Clique real na tela (coordenadas corrigidas pelo inset da GUI)
function Utils.clickAt(pos, gui)
	local sg = gui and gui:FindFirstAncestorOfClass("ScreenGui")
	local off = (sg and sg.IgnoreGuiInset) and Vector2.zero or GuiService:GetGuiInset()
	VIM:SendMouseButtonEvent(pos.X + off.X, pos.Y + off.Y, 0, true, game, 0)
	task.wait(0.02)
	VIM:SendMouseButtonEvent(pos.X + off.X, pos.Y + off.Y, 0, false, game, 0)
end

-- No celular o jogo só aceita E quando o último input foi de teclado ("modo computador").
-- Manda uma tecla neutra (F13) para forçar esse modo antes de interagir / apertar E.
function Utils.wakeKeyboard()
	local ok, key = pcall(function() return Enum.KeyCode.F13 end)
	if not (ok and key) then key = Enum.KeyCode.RightControl end
	pcall(function()
		VIM:SendKeyEvent(true, key, false, game)
		task.wait(0.01)
		VIM:SendKeyEvent(false, key, false, game)
	end)
end

-- Clica num botão: tenta disparar as conexões do botão; senão, clique real no centro.
function Utils.clickGui(g, onlyConnections)
	if g:IsA("GuiButton") and getconnections then
		local fired = false
		for _, ev in ipairs({ g.Activated, g.MouseButton1Click }) do
			local ok, conns = pcall(getconnections, ev)
			if ok and conns then
				for _, c in ipairs(conns) do
					if pcall(function() c:Fire() end) then fired = true end
				end
			end
		end
		if fired then return true end
	end
	if onlyConnections then return false end
	Utils.clickAt(g.AbsolutePosition + g.AbsoluteSize / 2, g)
	return true
end

-- Procura o botão "BEG!" do diálogo (texto exato, visível, fora da UI do hub)
local begCache
local function onScreen(g)
	local cam = workspace.CurrentCamera
	if not cam then return true end
	local vp, pos, size = cam.ViewportSize, g.AbsolutePosition, g.AbsoluteSize
	return pos.X + size.X > 0 and pos.Y + size.Y > 0 and pos.X < vp.X and pos.Y < vp.Y
end
function Utils.findBeg()
	if begCache and begCache.Parent and Utils.shown(begCache) and onScreen(begCache) then return begCache end
	begCache = nil
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end
	for _, g in ipairs(pg:GetDescendants()) do
		if (g:IsA("TextButton") or g:IsA("TextLabel")) and g.AbsoluteSize.X > 0 and g.AbsoluteSize.Y > 0 then
			local t = g.Text:gsub("<[^>]+>", "")
			t = t:gsub("%s", ""):lower()
			if t == "beg!" and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) and Utils.shown(g) and onScreen(g) then
				local node, clickable = g, g
				for _ = 1, 4 do
					if node:IsA("GuiButton") then clickable = node break end
					node = node.Parent
					if not node or not node:IsA("GuiObject") then break end
				end
				begCache = clickable
				return clickable
			end
		end
	end
	return nil
end

-- Acha e aperta o "X" da tela de conversa. Procura primeiro perto do botão BEG! (chain = ancestrais dele),
-- depois na ScreenGui inteira. Nunca mexe em outras telas.
local CLOSE_TEXT = { ["x"] = true, ["×"] = true, ["✕"] = true, ["✖"] = true, ["╳"] = true, ["✗"] = true }
local function findX(root)
	local best, bscore
	for _, g in ipairs(root:GetDescendants()) do
		if g:IsA("GuiButton") and g.AbsoluteSize.X > 0 and Utils.shown(g) and onScreen(g)
			and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
			local n = g.Name:lower()
			local t = (Utils.textOf(g):gsub("%s", ""))
			if CLOSE_TEXT[t] or n:find("close", 1, true) or n:find("fechar", 1, true) or n == "x"
				or n:find("exit", 1, true) or n:find("xbutton", 1, true) or n:find("xbtn", 1, true) then
				local score = g.AbsolutePosition.X - g.AbsolutePosition.Y * 0.5 -- prefere o canto superior direito
				if not bscore or score > bscore then best, bscore = g, score end
			end
		end
	end
	return best
end
function Utils.closeDialog(chain, sg)
	for _, node in ipairs(chain or {}) do
		if node.Parent and node:IsDescendantOf(game) then
			local x = findX(node)
			if x then
				Utils.clickGui(x)
				return true
			end
		end
	end
	if sg and sg.Parent then
		local x = findX(sg)
		if x then
			Utils.clickGui(x)
			return true
		end
	end
	return false
end

-- Estado do minigame
Utils.Minigame = { active = false, windowUntil = 0, seen = false, warned = false, count = 0 }
local Mini = Utils.Minigame

local Lock = { id = nil, target = nil, since = 0, engaged = false, lastFire = 0 }
local Ignored = setmetatable({}, { __mode = "k" })

local function valid(t)
	return t and t.prompt.Parent and t.prompt:IsDescendantOf(workspace) and t.part:IsDescendantOf(workspace)
end
local function release() Lock.target, Lock.id, Lock.engaged, Lock.offSince = nil, nil, false, nil end

local function npcPrompt(p)
	local model = p:FindFirstAncestorOfClass("Model")
	if not model or Players:GetPlayerFromCharacter(model) then return false end
	return model:FindFirstChildWhichIsA("Humanoid", true) ~= nil
		or model:FindFirstChildWhichIsA("AnimationController", true) ~= nil
end

-- Melhor alvo. Passo 1: palavras-chave. Passo 2 (só com fallback): qualquer NPC.
-- Personagens da lista de bloqueio são sempre ignorados.
-- Com raridades marcadas (só no Auto Talk): as marcadas ganham sempre; se StrictRarity, as outras são ignoradas.
-- Entre iguais: mais rara -> maior renda/s -> mais próxima.
function Utils.pickTarget(keywords, exclude, fallback)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local rareOn = Toggles.Get("rarest")
	-- o filtro só vale pro Auto Talk (missões não têm raridade)
	local filterOn = keywords == Configuration.Keywords.Talk and next(Configuration.RarityFilter) ~= nil
	local center = Configuration.AreaCenter or hrp.Position
	local radius = Configuration.AreaRadius
	if keywords == Configuration.Keywords.Rift then -- fenda: só o que está perto de você agora
		center, radius = hrp.Position, Configuration.RiftRadius
	end
	local best
	for pass = 1, 2 do
		if pass == 2 and (best or not (fallback and Configuration.NpcFallback)) then break end
		for p in pairs(Prompts) do
			local ig = Ignored[p]
			if p.Enabled and p:IsDescendantOf(workspace) and not (ig and os.clock() < ig) then
				local text = (p.ObjectText .. " " .. p.ActionText .. " " .. p:GetFullName()):lower()
				local ok
				if pass == 1 then ok = matches(text, keywords) else ok = npcPrompt(p) end
				if ok and not (exclude and matches(text, exclude)) and not Utils.isBlacklisted(p) then
					local part = p.Parent
					if part and part:IsA("Attachment") then part = part.Parent end
					if part and part:IsA("BasePart") then
						local d = (hrp.Position - part.Position).Magnitude
						if Configuration.NoArea[keywords] or (center - part.Position).Magnitude <= radius then
							local rank, income, allowed = 0, 0, true
							if rareOn or filterOn then
								local r, inc = Utils.rarityInfo(p)
								rank, income = r or 0, inc or 0
								if filterOn then
									local nm = r and Configuration.RarityOrder[r]
									if nm then
										if Configuration.RarityFilter[nm:lower()] then
											rank += 100 -- marcadas sempre vencem
										elseif Configuration.StrictRarity then
											allowed = false
										end
									end
									-- raridade ilegível: NÃO exclui (ordena pela renda/s), pra nunca ficar parado
								end
							end
							if allowed and (not best or rank > best.rank
								or (rank == best.rank and (income > best.income or (income == best.income and d < best.dist)))) then
								best = { prompt = p, part = part, dist = d, rank = rank, income = income }
							end
						end
					end
				end
			end
		end
	end
	return best
end

function Utils.lockedTarget(id, keywords, exclude, fallback)
	local t = Lock.target
	if t then
		if not valid(t) or not Toggles.Active(Lock.id) or Utils.isBlacklisted(t.prompt) then
			release()
		elseif os.clock() - Lock.since > Configuration.LockTimeout then
			Ignored[t.prompt] = os.clock() + 60
			release()
		elseif not t.prompt.Enabled then
			-- prompt desligado (já conversou / cooldown): não fica parado esperando
			Lock.offSince = Lock.offSince or os.clock()
			if os.clock() - Lock.offSince > 2 and not Utils.findBeg() and not Mini.active then
				Ignored[t.prompt] = os.clock() + 30
				release()
			end
		else
			Lock.offSince = nil
		end
	end
	if not Lock.target then
		local best = Utils.pickTarget(keywords, exclude, fallback)
		if best then
			Lock.target, Lock.id, Lock.since, Lock.engaged, Lock.lastFire = best, id, os.clock(), false, 0
			Lock.lastDist, Lock.lastProgress = nil, os.clock()
			Lock.fires, Lock.offSince = 0, nil
			Notifications.Push("Alvo", ("%s (%.0f studs)"):format(best.prompt.Parent and best.prompt.Parent.Name or "?", best.dist))
		elseif os.clock() - (Lock.clearedAt or 0) > 30 then
			Lock.clearedAt = os.clock()
			for k in pairs(Ignored) do Ignored[k] = nil end -- dá nova chance aos alvos pulados
		end
	elseif Lock.id == id and not Lock.engaged and os.clock() - (Lock.repickAt or 0) > 1 then
		Lock.repickAt = os.clock()
		local best = Utils.pickTarget(keywords, exclude, fallback)
		if best and (best.rank > Lock.target.rank
			or (best.rank == Lock.target.rank and best.income > (Lock.target.income or 0) * 1.5)) then
			Lock.target, Lock.since = best, os.clock()
		end
	end
	if Lock.id == id then return Lock.target end
	return nil
end

function Utils.currentTarget()
	local t = Lock.target
	if t and Lock.id and Toggles.Active(Lock.id) and valid(t) then return t end
	return nil
end

function Utils.interact(id, keywords, exclude, fallback)
	if not fireproximityprompt then
		Toggles.Set(id, false)
		Notifications.Push("Executor incompatível", "fireproximityprompt não está disponível.", "error")
		return
	end
	local t = Utils.lockedTarget(id, keywords, exclude, fallback)
	if not t then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp then return end
	local dist = (hrp.Position - t.part.Position).Magnitude
	if dist <= t.prompt.MaxActivationDistance + 1 then
		Lock.engaged = true
		if Mini.active then return end
		if t.prompt.Enabled and os.clock() - Lock.lastFire >= Configuration.RetryEvery then
			Lock.lastFire = os.clock()
			Lock.fires = (Lock.fires or 0) + 1
			if Lock.fires > 6 then
				Ignored[t.prompt] = os.clock() + 30
				release()
				return
			end
			Mini.windowUntil = os.clock() + 10
			pcall(function()
				t.prompt.HoldDuration = 0
				t.prompt.RequiresLineOfSight = false
			end)
			Utils.wakeKeyboard()
			fireproximityprompt(t.prompt)
			task.delay(6, function()
				if not Hub.Destroyed and Toggles.Active("perfect") and not Mini.seen and not Mini.warned
					and Utils.findBeg() then
					Mini.warned = true
					Notifications.Push("Beg", "Não detectei a linha vermelha. Abra o minigame, use o scan vermelho (aba Movimento) e preencha PerfectLine/PerfectMarker.", "warn")
				end
			end)
		end
	elseif Toggles.Get("moveto") and Configuration.MoveMode == "walk" and hum then
		hum:MoveTo(t.part.Position)
		if dist < (Lock.lastDist or math.huge) - 2 then
			Lock.lastDist, Lock.lastProgress = dist, os.clock()
		elseif os.clock() - (Lock.lastProgress or os.clock()) > 3 then
			-- travou em parede/obstáculo: pula e dá um empurrão em direção ao alvo
			hum.Jump = true
			local dir = t.part.Position - hrp.Position
			local stop = math.max(3, t.prompt.MaxActivationDistance * 0.7)
			if dir.Magnitude > stop then
				hrp.CFrame = hrp.CFrame + dir.Unit * math.min(dir.Magnitude - stop, 20)
			end
			Lock.lastProgress = os.clock() - 2
		end
	end
end

-- Tenta fechar o diálogo (botão cujo nome contém "close" na mesma ScreenGui)
local function tryClose(btn)
	local sg = btn:FindFirstAncestorOfClass("ScreenGui")
	if Utils.closeDialog(Utils.BegChain, sg) then return end
	if not sg then return end
	for _, d in ipairs(sg:GetDescendants()) do
		if d:IsA("GuiButton") and d.Name:lower():find("close") and Utils.shown(d) then
			Utils.clickGui(d)
			return
		end
	end
end

-- Fluxo completo da conversa:
--  diálogo fechado -> vai ao alvo e dispara o prompt
--  diálogo aberto  -> aperta BEG! (o módulo Beg acerta o perfeito) e repete a cada tentativa
local Beg = { last = 0, streak = 0, count = 0 }
-- O personagem da conversa sumiu? (removido do mapa, ficou invisível ou foi embora)
local function watchGone(w)
	local pr, part, model = w.prompt, w.part, w.model
	if not (pr.Parent and pr:IsDescendantOf(workspace)) then return true end
	if not (part.Parent and part:IsDescendantOf(workspace)) then return true end
	if model and not model:IsDescendantOf(workspace) then return true end
	if w.pos and (part.Position - w.pos).Magnitude > 60 then return true end
	if w.hadVisible and model then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 0.95 then return false end
		end
		return true
	end
	return false
end
function Utils.begStep(id, keywords, exclude, fallback)
	local btn = Utils.findBeg()
	if btn then
		-- guarda onde o diálogo está (para achar o X) e QUEM é o personagem da conversa
		Beg.sg = btn:FindFirstAncestorOfClass("ScreenGui")
		local chain, a = {}, btn.Parent
		for _ = 1, 6 do
			if not (a and a:IsA("GuiObject")) then break end
			chain[#chain + 1] = a
			a = a.Parent
		end
		Utils.BegChain = chain
		local t = Lock.target
		if t and Lock.id == id and not (Beg.watch and Beg.watch.prompt == t.prompt) then
			local model = t.prompt:FindFirstAncestorOfClass("Model")
			local vis = false
			if model then
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") and d.Transparency < 0.95 then vis = true break end
				end
			end
			Beg.watch = { prompt = t.prompt, part = t.part, model = model, pos = t.part.Position, hadVisible = vis }
			Beg.goneAt, Beg.closeTries = nil, 0
		end
		Beg.watchSeen = os.clock()
	end
	if Mini.active then Beg.watchSeen = os.clock() end
	-- só aperta o X quando o personagem SUMIR (coletado ou foi embora): nunca antes
	if Configuration.AutoCloseDialog and Beg.watch then
		if os.clock() - (Beg.watchSeen or 0) > 5 then
			Beg.watch, Beg.goneAt = nil, nil -- o diálogo já fechou sozinho
		elseif not Mini.active and watchGone(Beg.watch) then
			Beg.goneAt = Beg.goneAt or os.clock()
			if os.clock() - Beg.goneAt >= Configuration.CloseDelay and os.clock() - (Beg.lastCloseTry or 0) >= 0.6 then
				Beg.lastCloseTry = os.clock()
				Beg.closeTries = (Beg.closeTries or 0) + 1
				local closed = Utils.closeDialog(Utils.BegChain, Beg.sg)
				if closed or Beg.closeTries >= 4 then
					Beg.watch, Beg.goneAt, Beg.closeTries = nil, nil, 0
					Beg.last = os.clock()
					if not closed and Utils.findBeg() and os.clock() - (Beg.warnedClose or 0) > 60 then
						Beg.warnedClose = os.clock()
						Notifications.Push("Beg", "O personagem sumiu mas não achei o X da conversa.", "warn")
					end
				end
			end
		end
	end
	if btn and os.clock() < (Beg.skipUntil or 0) then btn = nil end -- desistiu deste diálogo: segue pro próximo alvo
	if not btn then
		Beg.streak = 0
		return Utils.interact(id, keywords, exclude, fallback)
	end
	Lock.fires = 0
	if Lock.id == id then Lock.engaged = true end
	if Mini.active or os.clock() - Beg.last < Configuration.BegClickEvery then return end
	if Mini.count ~= Beg.count then Beg.count, Beg.streak = Mini.count, 0 end
	if Beg.streak >= 5 then
		Beg.streak = 0
		Beg.skipUntil = os.clock() + 10
		if Lock.target then Ignored[Lock.target.prompt] = os.clock() + 60 end
		release()
		pcall(tryClose, btn)
		Notifications.Push("Beg", "O BEG! não iniciou o minigame 5x. Fechando e pulando este alvo.", "warn")
		return
	end
	Beg.last, Beg.streak = os.clock(), Beg.streak + 1
	Mini.windowUntil = os.clock() + 8
	Utils.wakeKeyboard()
	Utils.clickGui(btn)
end

function Configuration.ScanRed()
	local out = {}
	for _, g in ipairs(LocalPlayer:WaitForChild("PlayerGui"):GetDescendants()) do
		if g:IsA("GuiObject") and Utils.shown(g) and Utils.isRed(g) then
			table.insert(out, "LINHA VERMELHA? " .. g:GetFullName())
			for _, sib in ipairs(g.Parent and g.Parent:GetChildren() or {}) do
				if sib ~= g and sib:IsA("GuiObject") and Utils.shown(sib) then
					table.insert(out, "    irmão visível (marcador?): " .. sib:GetFullName())
				end
			end
		end
	end
	if #out == 0 then out[1] = "Nenhuma GUI vermelha visível. Abra o minigame e tente de novo." end
	local text = table.concat(out, "\n")
	print(text)
	if setclipboard then pcall(setclipboard, text) end
	Notifications.Push("Scan vermelho", #out .. " linhas no console" .. (setclipboard and " e na área de transferência." or "."))
end

local function dumpModel(p)
	local model = p:FindFirstAncestorOfClass("Model")
	if not model then return "    (sem Model)" end
	local parts = {}
	for k, v in pairs(model:GetAttributes()) do table.insert(parts, "attr " .. k .. "=" .. tostring(v)) end
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
			n += 1
			if n <= 12 then table.insert(parts, "texto '" .. d.Text:sub(1, 30) .. "'") end
		end
	end
	return "    modelo " .. model.Name .. " | " .. table.concat(parts, " | ")
end

function Configuration.ScanNearby()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local list = {}
	for p in pairs(Prompts) do
		local part = p.Parent
		if part and part:IsA("Attachment") then part = part.Parent end
		if part and part:IsA("BasePart") then
			table.insert(list, { p = p, d = (hrp.Position - part.Position).Magnitude })
		end
	end
	table.sort(list, function(a, b) return a.d < b.d end)
	local out = {}
	for i = 1, math.min(15, #list) do
		local e = list[i]
		local rk, inc = Utils.rarityInfo(e.p)
		table.insert(out, ("%.0f studs | ativo=%s | bloqueado=%s | objeto='%s' | ação='%s' | raridade=%s | renda=%s | %s"):format(
			e.d, tostring(e.p.Enabled), tostring(Utils.isBlacklisted(e.p)), e.p.ObjectText, e.p.ActionText,
			tostring(rk), tostring(inc), e.p:GetFullName()))
		if i <= 3 then table.insert(out, dumpModel(e.p)) end
	end
	if #out == 0 then out[1] = "Nenhum prompt encontrado." end
	local text = table.concat(out, "\n")
	print(text)
	if setclipboard then pcall(setclipboard, text) end
	Notifications.Push("Prompts por perto", #out .. " linhas no console" .. (setclipboard and " e na área de transferência." or "."))
end

function Configuration.Scan()
	local out = { "== REMOTES (ReplicatedStorage) ==" }
	for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			table.insert(out, d.ClassName .. ": " .. d:GetFullName())
		end
	end
	table.insert(out, "== PROXIMITY PROMPTS ==")
	for p in pairs(Prompts) do
		table.insert(out, ("%s | objeto='%s' | ação='%s'"):format(p:GetFullName(), p.ObjectText, p.ActionText))
	end
	table.insert(out, "== PLAYERGUI ==")
	for _, g in ipairs(LocalPlayer:WaitForChild("PlayerGui"):GetChildren()) do
		table.insert(out, g.ClassName .. ": " .. g.Name)
	end
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	if ls then
		table.insert(out, "== LEADERSTATS ==")
		for _, v in ipairs(ls:GetChildren()) do table.insert(out, v.ClassName .. ": " .. v:GetFullName()) end
	end
	local text = table.concat(out, "\n")
	print(text)
	if setclipboard then pcall(setclipboard, text) end
	Notifications.Push("Scan concluído", #out .. " linhas no console" .. (setclipboard and " e na área de transferência." or "."))
end

-- Lê a lista de raridades direto do Index (linhas "Common 8/8", "Rare 9/9"...)
function Configuration.DetectRarities(silent)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local found, seen = {}, {}
	if pg then
		for _, g in ipairs(pg:GetDescendants()) do
			if g:IsA("TextLabel") and g.Parent and g.Text:match("^%s*%d+%s*/%s*%d+%s*$") then
				for _, s in ipairs(g.Parent:GetChildren()) do
					if s:IsA("TextLabel") and s ~= g then
						local t = s.Text:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", "")
						local key = t:lower()
						if t:match("^%a+$") and #t >= 4 and #t <= 14 and key ~= "todos" and key ~= "all" and not seen[key] then
							seen[key] = true
							table.insert(found, { name = t, y = g.Parent.AbsolutePosition.Y, i = #found })
						end
					end
				end
			end
		end
	end
	if #found < 3 or not seen.common then
		if not silent then
			Notifications.Push("Raridades", "Não achei a lista. Abra o Index e tente de novo (mantive a padrão).", "warn")
		end
		return false
	end
	table.sort(found, function(a, b) if a.y ~= b.y then return a.y < b.y end return a.i < b.i end)
	local list = {}
	for _, f in ipairs(found) do table.insert(list, f.name) end
	Configuration.RarityOrder = list
	if not silent then Notifications.Push("Raridades", #list .. " raridades detectadas no Index.") end
	return true
end

