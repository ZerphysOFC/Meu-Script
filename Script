-- Alerta de raridade: avisa quando um Baddie das raridades marcadas aparece no mapa (sem limite de distância)
Modules.Alerts = { Init = function()
	local seen = setmetatable({}, { __mode = "k" })
	local function goTo(st)
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then error("Personagem não encontrado") end
		local pos = st.pos
		if st.part and st.part.Parent and st.part:IsDescendantOf(workspace) then pos = st.part.Position end
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
	end
	local function scan()
		local pushed = 0
		for p in pairs(Prompts) do
			if p:IsDescendantOf(workspace) then
				local model = p:FindFirstAncestorOfClass("Model")
				local part = p.Parent
				if part and part:IsA("Attachment") then part = part.Parent end
				if model and part and part:IsA("BasePart") and not Players:GetPlayerFromCharacter(model) then
					local st = seen[model]
					if not st then
						local text = promptInfo(p).text
						if matches(text, Configuration.Keywords.Talk) or npcPrompt(p) then
							st = { tries = 0, done = false, pos = part.Position, part = part }
							seen[model] = st
						end
					end
					if st then
						st.pos, st.part = part.Position, part -- guarda a última localização
						if not st.done then
							st.tries += 1
							local rank = Utils.rarityInfo(p)
							if rank and rank > 0 then
								local name = Configuration.RarityOrder[rank]
								if not name or not Configuration.NotifyFilter[name:lower()] then
									st.done = true
								elseif pushed < 3 then
									st.done = true
									pushed += 1
									Notifications.Push("Raridade: " .. name:sub(1, 1):upper() .. name:sub(2),
										model.Name .. " apareceu no mapa.", "rarity",
										{ text = "Ir até ele", fn = function() goTo(st) end })
								end
							elseif st.tries >= 6 then
								st.done = true
							end
						end
					end
				end
			end
		end
	end
	task.spawn(function()
		while not Hub.Destroyed do
			if Toggles.State.master and next(Configuration.NotifyFilter) then pcall(scan) end
			task.wait(3)
		end
	end)
end }

