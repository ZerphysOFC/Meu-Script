-- Palavras que NUNCA devem ser tratadas como raid (RAID SHOP, Cursed Shards, Infinity Shards...)
local NOT_RAID = { "shop", "loja", "store", "shard", "mercado", "robux", "premium", "gamepass" }

-- Prompt do "pad" do centro da raid: o mais próximo de você
function Utils.firePad(radius)
	if not fireproximityprompt then return false end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local best, bd
	for p in pairs(Prompts) do
		if p.Enabled and p:IsDescendantOf(workspace) and not Utils.isBlacklisted(p) and not npcPrompt(p) then
			local txt = (p.ObjectText .. " " .. p.ActionText .. " " .. p:GetFullName()):lower()
			local part = p.Parent
			if part and part:IsA("Attachment") then part = part.Parent end
			if part and part:IsA("BasePart") and not matches(txt, NOT_RAID) then
				local d = (hrp.Position - part.Position).Magnitude
				if d <= radius and (not bd or d < bd) then best, bd = p, d end
			end
		end
	end
	if not best then return false end
	pcall(function()
		best.HoldDuration = 0
		best.RequiresLineOfSight = false
	end)
	Utils.wakeKeyboard()
	fireproximityprompt(best)
	return true
end

