local Toggles = { State = { master = true, notifications = true, rarest = true }, Listeners = {} }
Toggles.Event = Instance.new("BindableEvent")
table.insert(Hub.Cleanup, Toggles.Event)
function Toggles.Get(id)
	if id == "perfect" then return Toggles.State.talk == true end
	if id == "moveto" then
		return Toggles.State.talk == true or Toggles.State.rift == true or Toggles.State.raid == true
	end
	return Toggles.State[id] == true
end
function Toggles.Active(id) return Toggles.State.master == true and Toggles.Get(id) end
function Toggles.Listen(fn) table.insert(Toggles.Listeners, fn) end
function Toggles.Set(id, v)
	Toggles.State[id] = v and true or false
	for _, fn in ipairs(Toggles.Listeners) do pcall(fn, id) end
	Toggles.Event:Fire()
end

