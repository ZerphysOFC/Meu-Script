-- Fechamento completo: desliga tudo, solta o alvo, desconecta e remove a interface
function Hub.Destroy()
	if Hub.DestroyDone then return end
	Hub.DestroyDone = true
	Hub.Destroyed = true
	pcall(function() Gui.Enabled = false end)
	for id in pairs(Toggles.State) do
		if id ~= "master" and id ~= "notifications" and id ~= "rarest" then Toggles.State[id] = false end
	end
	pcall(release)
	pcall(function() Toggles.Event:Fire() end)
	for _, c in ipairs(Hub.Cleanup) do
		pcall(function()
			if typeof(c) == "RBXScriptConnection" then c:Disconnect() else c:Destroy() end
		end)
	end
	pcall(function() Gui:Destroy() end)
	if env.BegABaddiesHub == Hub then env.BegABaddiesHub = nil end
end

