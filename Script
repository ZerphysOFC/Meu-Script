Utils.Minigame = { active = false, windowUntil = 0, seen = false, count = 0 }
local Mini = Utils.Minigame

local Lock = { id = nil, target = nil, since = 0, engaged = false, lastFire = 0 }
local Ignored = setmetatable({}, { __mode = "k" })

local function valid(t)
	return t and t.prompt.Parent and t.prompt:IsDescendantOf(workspace) and t.part:IsDescendantOf(workspace)
end
local function release() Lock.target, Lock.id, Lock.engaged, Lock.offSince = nil, nil, false, nil end

local NpcCache = setmetatable({}, { __mode = "k" })
local function npcPrompt(p)
	local c = NpcCache[p]
	if c and os.clock() - c.t < 10 then return c.v end
	local v = false
	local model = p:FindFirstAncestorOfClass("Model")
	if model and not Players:GetPlayerFromCharacter(model) then
		v = model:FindFirstChildWhichIsA("Humanoid", true) ~= nil
			or model:FindFirstChildWhichIsA("AnimationController", true) ~= nil
	end
	NpcCache[p] = { v = v, t = os.clock() }
	return v
end

-- Texto/peça de cada prompt em cache (GetFullName e lower() são caros em milhares de prompts)
local PromptInfo = setmetatable({}, { __mode = "k" })
local function promptInfo(p)
	local c = PromptInfo[p]
	local now = os.clock()
	if c and now - c.t < 6 then return c end
	local part = p.Parent
	if part and part:IsA("Attachment") then part = part.Parent end
	c = {
		text = (p.ObjectText .. " " .. p.ActionText .. " " .. p:GetFullName()):lower(),
		part = part, t = now, kw = setmetatable({}, { __mode = "k" }), ex = setmetatable({}, { __mode = "k" }),
	}
	PromptInfo[p] = c
	return c
end

function Utils.pickTarget(keywords, exclude, fallback)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or Configuration.ZoneBusy then return nil end
	local rareOn = Toggles.Get("rarest")
	local filterOn = keywords == Configuration.Keywords.Talk and next(Configuration.RarityFilter) ~= nil
	local zc = Configuration.FarmZone and Configuration.ZoneCenters[Configuration.FarmZone]
	local center = zc or Configuration.AreaCenter or hrp.Position
	local radius = zc and Configuration.ZoneRadius or Configuration.AreaRadius
	if keywords == Configuration.Keywords.Rift then
		center, radius = hrp.Position, Configuration.RiftRadius
	end
	local hpos = hrp.Position
	local noArea = Configuration.NoArea[keywords]
	local now = os.clock()
	local best
	for pass = 1, 2 do
		if pass == 2 and (best or not (fallback and Configuration.NpcFallback)) then break end
		for p in pairs(Prompts) do
			local ig = Ignored[p]
			if p.Enabled and not (ig and now < ig) and p:IsDescendantOf(workspace) then
				local info = promptInfo(p)
				local part = info.part
				-- 1) o mais barato primeiro: é peça e está dentro da área?
				if part and part:IsA("BasePart") and (noArea or (center - part.Position).Magnitude <= radius) then
					-- 2) bate com as palavras (resultado em cache por prompt)?
					local ok
					if pass == 1 then
						ok = info.kw[keywords]
						if ok == nil then
							ok = matches(info.text, keywords)
							info.kw[keywords] = ok
						end
					else
						ok = npcPrompt(p)
					end
					if ok and exclude then
						local ex = info.ex[exclude]
						if ex == nil then
							ex = matches(info.text, exclude)
							info.ex[exclude] = ex
						end
						if ex then ok = false end
					end
					-- 3) só agora as checagens pesadas (lista de bloqueio e raridade)
					if ok and not Utils.isBlacklisted(p) then
						local d = (hpos - part.Position).Magnitude
						local rank, income, allowed = 0, 0, true
						if rareOn or filterOn then
							local r, inc = Utils.rarityInfo(p)
							rank, income = r or 0, inc or 0
							if filterOn then
								local nm = r and Configuration.RarityOrder[r]
								if nm then
									if Configuration.RarityFilter[nm:lower()] then
										rank += 100
									elseif Configuration.StrictRarity then
										allowed = false
									end
								end
							end
						end
						if allowed and (not best or rank > best.rank
							or (rank == best.rank and (income > best.income or (income == best.income and d < best.dist)))) then
							best = { prompt = p, part = part, dist = d, rank = rank, income = income }
						end
					end
				end
			end
		end
	end
	return best
end

function Utils.lockedTarget(id, keywords, exclude, fallback)
	local t = Lock.target
	if t then
		if not valid(t) or not Toggles.Active(Lock.id) or Utils.isBlacklisted(t.prompt) then
			release()
		elseif os.clock() - Lock.since > Configuration.LockTimeout then
			Ignored[t.prompt] = os.clock() + 60
			release()
		elseif not t.prompt.Enabled then
			Lock.offSince = Lock.offSince or os.clock()
			if os.clock() - Lock.offSince > 2 and not Utils.findBeg() and not Mini.active then
				Ignored[t.prompt] = os.clock() + 30
				release()
			end
		else
			Lock.offSince = nil
		end
	end
	if not Lock.target then
		if os.clock() < (Lock.nextPick or 0) then return nil end
		Lock.nextPick = os.clock() + 0.4
		local best = Utils.pickTarget(keywords, exclude, fallback)
		if best then
			Lock.target, Lock.id, Lock.since, Lock.engaged, Lock.lastFire = best, id, os.clock(), false, 0
			Lock.lastDist, Lock.lastProgress = nil, os.clock()
			Lock.fires, Lock.offSince = 0, nil
		elseif os.clock() - (Lock.clearedAt or 0) > 30 then
			Lock.clearedAt = os.clock()
			for k in pairs(Ignored) do Ignored[k] = nil end
		end
	elseif Lock.id == id and not Lock.engaged and os.clock() - (Lock.repickAt or 0) > 1.5 then
		Lock.repickAt = os.clock()
		local best = Utils.pickTarget(keywords, exclude, fallback)
		if best and (best.rank > Lock.target.rank
			or (best.rank == Lock.target.rank and best.income > (Lock.target.income or 0) * 1.5)) then
			Lock.target, Lock.since = best, os.clock()
		end
	end
	if Lock.id == id then return Lock.target end
	return nil
end

function Utils.currentTarget()
	local t = Lock.target
	if t and Lock.id and Toggles.Active(Lock.id) and valid(t) then return t end
	return nil
end

function Utils.interact(id, keywords, exclude, fallback)
	if not fireproximityprompt then
		Toggles.Set(id, false)
		Notifications.Push("Executor incompatível", "fireproximityprompt não está disponível.", "error")
		return
	end
	local t = Utils.lockedTarget(id, keywords, exclude, fallback)
	if not t then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp then return end
	local dist = (hrp.Position - t.part.Position).Magnitude
	if dist <= t.prompt.MaxActivationDistance + 1 then
		Lock.engaged = true
		if Mini.active then return end
		if t.prompt.Enabled and os.clock() - Lock.lastFire >= T("RetryEvery") then
			Lock.lastFire = os.clock()
			Lock.fires = (Lock.fires or 0) + 1
			if Lock.fires > 6 then
				Ignored[t.prompt] = os.clock() + 30
				release()
				return
			end
			Mini.windowUntil = os.clock() + 10
			pcall(function()
				t.prompt.HoldDuration = 0
				t.prompt.RequiresLineOfSight = false
			end)
			Utils.wakeKeyboard()
			fireproximityprompt(t.prompt)
		end
	elseif Toggles.Get("moveto") and Configuration.MoveMode == "walk" and hum then
		hum:MoveTo(t.part.Position)
		if dist < (Lock.lastDist or math.huge) - 2 then
			Lock.lastDist, Lock.lastProgress = dist, os.clock()
		elseif os.clock() - (Lock.lastProgress or os.clock()) > 3 then
			hum.Jump = true
			local dir = t.part.Position - hrp.Position
			local stop = math.max(3, t.prompt.MaxActivationDistance * 0.7)
			if dir.Magnitude > stop then
				hrp.CFrame = hrp.CFrame + dir.Unit * math.min(dir.Magnitude - stop, 20)
			end
			Lock.lastProgress = os.clock() - 2
		end
	end
end

local function tryClose(btn)
	local sg = btn:FindFirstAncestorOfClass("ScreenGui")
	if Utils.closeDialog(Utils.BegChain, sg) then return end
	if not sg then return end
	for _, d in ipairs(sg:GetDescendants()) do
		if d:IsA("GuiButton") and d.Name:lower():find("close") and Utils.shown(d) then
			Utils.clickGui(d)
			return
		end
	end
end

local Beg = { last = 0, streak = 0, count = 0 }
local function watchGone(w)
	local pr, part, model = w.prompt, w.part, w.model
	if not (pr.Parent and pr:IsDescendantOf(workspace)) then return true end
	if not (part.Parent and part:IsDescendantOf(workspace)) then return true end
	if model and not model:IsDescendantOf(workspace) then return true end
	if w.pos and (part.Position - w.pos).Magnitude > 60 then return true end
	if w.hadVisible and model then
		if os.clock() - (w.at or 0) < 0.4 then return w.res == true end
		w.at, w.res = os.clock(), true
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 0.95 then w.res = false break end
		end
		return w.res
	end
	return false
end

function Utils.begStep(id, keywords, exclude, fallback)
	local btn = Utils.findBeg()
	if btn then
		Beg.sg = btn:FindFirstAncestorOfClass("ScreenGui")
		local chain, a = {}, btn.Parent
		for _ = 1, 6 do
			if not (a and a:IsA("GuiObject")) then break end
			chain[#chain + 1] = a
			a = a.Parent
		end
		Utils.BegChain = chain
		local t = Lock.target
		if t and Lock.id == id and not (Beg.watch and Beg.watch.prompt == t.prompt) then
			local model = t.prompt:FindFirstAncestorOfClass("Model")
			local vis = false
			if model then
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") and d.Transparency < 0.95 then vis = true break end
				end
			end
			Beg.watch = { prompt = t.prompt, part = t.part, model = model, pos = t.part.Position, hadVisible = vis }
			Beg.goneAt, Beg.closeTries = nil, 0
		end
		Beg.watchSeen = os.clock()
	end
	if Mini.active then Beg.watchSeen = os.clock() end
	-- só aperta o X quando o personagem SUMIR (coletado ou foi embora)
	if Configuration.AutoCloseDialog and Beg.watch then
		if os.clock() - (Beg.watchSeen or 0) > 5 then
			Beg.watch, Beg.goneAt = nil, nil
		elseif not Mini.active and watchGone(Beg.watch) then
			Beg.goneAt = Beg.goneAt or os.clock()
			if os.clock() - Beg.goneAt >= T("CloseDelay") and os.clock() - (Beg.lastCloseTry or 0) >= 0.6 then
				Beg.lastCloseTry = os.clock()
				Beg.closeTries = (Beg.closeTries or 0) + 1
				local closed = Utils.closeDialog(Utils.BegChain, Beg.sg)
				if closed or Beg.closeTries >= 4 then
					Beg.watch, Beg.goneAt, Beg.closeTries = nil, nil, 0
					Beg.last = os.clock()
				end
			end
		end
	end
	if btn and os.clock() < (Beg.skipUntil or 0) then btn = nil end
	if not btn then
		Beg.streak = 0
		return Utils.interact(id, keywords, exclude, fallback)
	end
	Lock.fires = 0
	if Lock.id == id then Lock.engaged = true end
	if Mini.active or os.clock() - Beg.last < T("BegClickEvery") then return end
	if Mini.count ~= Beg.count then Beg.count, Beg.streak = Mini.count, 0 end
	if Beg.streak >= 5 then
		Beg.streak = 0
		Beg.skipUntil = os.clock() + 10
		if Lock.target then Ignored[Lock.target.prompt] = os.clock() + 60 end
		release()
		pcall(tryClose, btn)
		return
	end
	Beg.last, Beg.streak = os.clock(), Beg.streak + 1
	Mini.windowUntil = os.clock() + 8
	Utils.wakeKeyboard()
	Utils.clickGui(btn)
end

