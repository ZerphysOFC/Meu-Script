-- Loja: acha as lojas de poções/venenos/gifts e compra tudo com dinheiro do jogo (leve: só varre o painel da loja)
--==================================================================
Modules.Shop = { Name = "Loja", Icon = "🛒", Sub = "Poções, venenos, gifts e auras", Init = function(page)
	page:Section("Loja")
	local TITLES = {
		"loja de poç", "loja de poc", "loja de venen", "potion shop", "poison shop", "reabastecimento", "restock",
		"gift shop", "loja de gift", "loja de presente", "gifts",
	}
	local BUY_WORDS = { "buy", "comprar", "compra", "purchase" }
	local BAD_WORDS = {
		"esgotado", "sold out", "bloquead", "locked", "indispon", "owned", "adquirido", "equipado",
		"automát", "automat", "reclamar", "resgatar", "claim", "buy all", "comprar tudo",
	}
	local function clean(t) return (t:gsub("<[^>]+>", "")) end
	local function starText(t)
		return t:find("%f[%a]stars?%f[%A]") or t:find("estrela") or t:find("%f[%a]gems?%f[%A]") or t:find("gema")
			or t:find("diamond") or t:find("diamante") or t:find("★", 1, true) or t:find("⭐", 1, true)
	end
	local function textOf(g)
		local t = {}
		if g:IsA("TextButton") and g.Text ~= "" then table.insert(t, g.Text) end
		for _, d in ipairs(g:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then table.insert(t, d.Text) end
		end
		return clean(table.concat(t, " ")):lower()
	end
	local function robuxNode(node)
		local cur = node
		for _ = 1, 4 do
			if not cur or cur == game then break end
			local l = cur.Name:lower()
			if l == "templates" or l:find("robux") or l:find("premium") or l:find("gamepass") or cur.Name:match("^Rx%u") then
				return true
			end
			for _, f in ipairs(Configuration.SkipFlags) do
				if cur:GetAttribute(f) then return true end
			end
			cur = cur.Parent
		end
		for _, d in ipairs(node:GetDescendants()) do
			local n = d.Name:lower()
			if n:find("robux") or n:find("premium") or n:find("gamepass") then return true end
		end
		return false
	end

	-- devolve { btn, price, text } se o botão é um item COMPRÁVEL com dinheiro do jogo
	local function analyze(btn)
		local own = textOf(btn)
		local price = Utils.parsePrice(own)
		if not (price or matches(own, BUY_WORDS)) then return nil end
		if matches(own, BAD_WORDS) or starText(own) or own:find("r%$") or own:find("robux") then return nil end
		local scope = btn
		if not price then
			local card = btn.Parent
			if card and card:IsA("GuiObject") and #card:GetChildren() <= 8 then scope = card end
		end
		local ctx = (scope == btn) and own or (own .. " " .. textOf(scope))
		if matches(ctx, BAD_WORDS) or starText(ctx) or ctx:find("r%$") or ctx:find("robux") or ctx:find("premium") then return nil end
		if robuxNode(scope) then return nil end
		return { btn = btn, price = price or Utils.parsePrice(ctx), text = ctx }
	end

	-- acha os painéis das lojas pelo título (varredura pesada: só a cada poucos segundos)
	local roots, rootsAt = {}, 0
	local function findRoots()
		local out, seen = {}, {}
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return out end
		for _, g in ipairs(pg:GetDescendants()) do
			if g:IsA("TextLabel") and g.Text ~= "" and #g.Text < 40 and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
				local t = clean(g.Text):lower()
				for _, w in ipairs(TITLES) do
					if t:find(w, 1, true) then
						local a = g
						for _ = 1, 3 do
							if a.Parent and a.Parent:IsA("GuiObject") then a = a.Parent end
						end
						if not seen[a] then
							seen[a] = true
							out[#out + 1] = a
						end
						break
					end
				end
			end
		end
		return out
	end

	local lastBuy = setmetatable({}, { __mode = "k" })
	Feature(page, "shop_gui", "Auto Buy Poções / Venenos / Gifts",
		"Acha sozinho as lojas e compra todos os itens com dinheiro do jogo. Ignora Robux, estrelas/gemas e 'Compra Automática'.",
		1.2, function()
			if os.clock() - rootsAt > (#roots == 0 and 2 or 5) then
				roots, rootsAt = findRoots(), os.clock()
			end
			local money = Utils.money()
			local seen, list = {}, {}
			for _, root in ipairs(roots) do
				if root.Parent and (CAN_HIDDEN or Utils.shown(root)) then
					for _, d in ipairs(root:GetDescendants()) do
						if d:IsA("GuiButton") and not seen[d] and (CAN_HIDDEN or Utils.shown(d)) then
							seen[d] = true
							local info = analyze(d)
							if info and not (info.price and money and info.price > money) then
								table.insert(list, info)
							end
						end
					end
				end
			end
			table.sort(list, function(a, b) return (a.price or 0) < (b.price or 0) end)
			for _, info in ipairs(list) do
				if not Toggles.Active("shop_gui") then break end
				local btn = info.btn
				if btn.Parent and os.clock() - (lastBuy[btn] or 0) >= 0.8 then
					lastBuy[btn] = os.clock()
					Utils.scrollInto(btn)
					Utils.clickGui(btn, not Utils.shown(btn))
					Notifications.Buy((info.text:gsub("%s+", " ")):sub(1, 60))
					task.wait(0.15)
				end
			end
		end, true)

	local AURA_BUY = { "buy", "comprar", "compra", "purchase", "unlock", "desbloquear", "obter" }
	local AURA_BAD = { "equip", "renascimento", "rebirth", "robux", "r$", "buy all", "comprar tudo", "esgotado", "sold out" }
	local lastAura = setmetatable({}, { __mode = "k" })
	local function auraButtons()
		local out = {}
		for _, e in ipairs(Utils.buttons(true)) do
			local t = e.text
			local price = Utils.parsePrice(t)
			if (price or matches(t, AURA_BUY)) and not matches(t, AURA_BAD) and not starText(t) then
				local scope, ok = e.btn.Parent, false
				for _ = 1, 3 do
					if scope and scope:IsA("GuiObject") then
						local st = Utils.textOf(scope)
						if st:find("aura", 1, true) and not st:find("poç", 1, true) and not st:find("venen", 1, true) then ok = true break end
						scope = scope.Parent
					end
				end
				if ok then
					e.price = price
					table.insert(out, e)
				end
			end
		end
		return out
	end
	Feature(page, "shop_aura", "Auto Buy Auras",
		"Compra toda aura que ficar disponível (ignora Robux, estrelas e as bloqueadas por Renascimento).", 2, function()
			local money = Utils.money()
			for _, e in ipairs(auraButtons()) do
				if not Toggles.Active("shop_aura") then break end
				local btn = e.btn
				if btn.Parent and os.clock() - (lastAura[btn] or 0) >= 2 and not (e.price and money and e.price > money) then
					lastAura[btn] = os.clock()
					Utils.scrollInto(btn)
					Utils.clickGui(btn, not Utils.shown(btn))
					Notifications.Buy("Aura: " .. e.text:sub(1, 40))
					task.wait(0.2)
				end
			end
		end)
end }

