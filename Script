function Utils.shown(g)
	while g and g ~= game do
		if g:IsA("GuiObject") and not g.Visible then return false end
		if g:IsA("LayerCollector") and not g.Enabled then return false end
		g = g.Parent
	end
	return true
end

local function isRedColor(c) return c.R > 0.6 and c.G < 0.32 and c.B < 0.5 and (c.R - c.G) > 0.4 end

local function tinted(base, g)
	local gr = g:FindFirstChildOfClass("UIGradient")
	if gr then
		local kp = gr.Color.Keypoints
		local k = kp[math.ceil(#kp / 2)].Value
		return Color3.new(base.R * k.R, base.G * k.G, base.B * k.B)
	end
	return base
end

function Utils.isRed(g)
	if g.BackgroundTransparency < 0.9 and isRedColor(tinted(g.BackgroundColor3, g)) then return true end
	if (g:IsA("ImageLabel") or g:IsA("ImageButton")) and g.ImageTransparency < 0.9
		and isRedColor(tinted(g.ImageColor3, g)) then
		return true
	end
	return false
end

function Utils.clickAt(pos, gui)
	local sg = gui and gui:FindFirstAncestorOfClass("ScreenGui")
	local off = (sg and sg.IgnoreGuiInset) and Vector2.zero or GuiService:GetGuiInset()
	VIM:SendMouseButtonEvent(pos.X + off.X, pos.Y + off.Y, 0, true, game, 0)
	task.wait(0.02)
	VIM:SendMouseButtonEvent(pos.X + off.X, pos.Y + off.Y, 0, false, game, 0)
end

-- No celular o jogo só aceita E quando o último input foi de teclado: manda uma tecla neutra antes.
function Utils.wakeKeyboard()
	local ok, key = pcall(function() return Enum.KeyCode.F13 end)
	if not (ok and key) then key = Enum.KeyCode.RightControl end
	pcall(function()
		VIM:SendKeyEvent(true, key, false, game)
		task.wait(0.01)
		VIM:SendKeyEvent(false, key, false, game)
	end)
end

function Utils.clickGui(g, onlyConnections)
	if g:IsA("GuiButton") and getconnections then
		local fired = false
		for _, ev in ipairs({ g.Activated, g.MouseButton1Click }) do
			local ok, conns = pcall(getconnections, ev)
			if ok and conns then
				for _, c in ipairs(conns) do
					if pcall(function() c:Fire() end) then fired = true end
				end
			end
		end
		if fired then return true end
	end
	if onlyConnections then return false end
	Utils.clickAt(g.AbsolutePosition + g.AbsoluteSize / 2, g)
	return true
end

local begCache
local function onScreen(g)
	local cam = workspace.CurrentCamera
	if not cam then return true end
	local vp, pos, size = cam.ViewportSize, g.AbsolutePosition, g.AbsoluteSize
	return pos.X + size.X > 0 and pos.Y + size.Y > 0 and pos.X < vp.X and pos.Y < vp.Y
end
local begScanAt = 0
function Utils.findBeg()
	if begCache and begCache.Parent and Utils.shown(begCache) and onScreen(begCache) then return begCache end
	begCache = nil
	local now = os.clock()
	local mg = Utils.Minigame
	local gap = (mg and now < mg.windowUntil) and 0.12 or 0.5
	if now - begScanAt < gap then return nil end
	begScanAt = now
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end
	Utils.startTracking()
	for g in pairs(Tracked.texts) do
		if g.Visible and g.AbsoluteSize.X > 0 and g.AbsoluteSize.Y > 0 then
			local t = g.Text:gsub("<[^>]+>", "")
			t = t:gsub("%s", ""):lower()
			if t == "beg!" and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) and Utils.shown(g) and onScreen(g) then
				local node, clickable = g, g
				for _ = 1, 4 do
					if node:IsA("GuiButton") then clickable = node break end
					node = node.Parent
					if not node or not node:IsA("GuiObject") then break end
				end
				begCache = clickable
				return clickable
			end
		end
	end
	return nil
end

local CLOSE_TEXT = { ["x"] = true, ["×"] = true, ["✕"] = true, ["✖"] = true, ["╳"] = true, ["✗"] = true }
local function findX(root)
	local best, bscore
	for _, g in ipairs(root:GetDescendants()) do
		if g:IsA("GuiButton") and g.AbsoluteSize.X > 0 and Utils.shown(g) and onScreen(g)
			and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
			local n = g.Name:lower()
			local t = (Utils.textOf(g):gsub("%s", ""))
			if CLOSE_TEXT[t] or n:find("close", 1, true) or n:find("fechar", 1, true) or n == "x"
				or n:find("exit", 1, true) or n:find("xbutton", 1, true) or n:find("xbtn", 1, true) then
				local score = g.AbsolutePosition.X - g.AbsolutePosition.Y * 0.5
				if not bscore or score > bscore then best, bscore = g, score end
			end
		end
	end
	return best
end
function Utils.closeDialog(chain, sg)
	for _, node in ipairs(chain or {}) do
		if node.Parent and node:IsDescendantOf(game) then
			local x = findX(node)
			if x then
				Utils.clickGui(x)
				return true
			end
		end
	end
	if sg and sg.Parent then
		local x = findX(sg)
		if x then
			Utils.clickGui(x)
			return true
		end
	end
	return false
end

