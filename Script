		"Fica ligado: acha a zona vermelha (onde estiver) e aperta E quando o risco branco passa nela. Ajustes na aba 'Config. Autofarm'.", true)

	local manual = { marker = nil, line = nil, t = 0 }
	local auto = { zone = nil, marker = nil, samples = {}, roots = nil, rootsAt = 0, t = 0 }
	local prev, velS, moveAt, stale, beat = nil, 0, 0, false, nil
	local roundState = { presses = 0, last = 0 }

	local function manualParts()
		if not (manual.marker and manual.marker.Parent and manual.line and manual.line.Parent) then
			if os.clock() - manual.t < 0.25 then return nil end
			manual.t = os.clock()
			manual.marker = Utils.resolve(Configuration.Paths.PerfectMarker)
			manual.line = Utils.resolve(Configuration.Paths.PerfectLine)
		end
		if manual.marker and manual.line and manual.marker:IsA("GuiObject") and manual.line:IsA("GuiObject") then
			return manual.marker, manual.line
		end
		return nil
	end

	-- sobreposição no eixo perpendicular ao movimento (o risco atravessa a barra)
	local function overlap(horiz, a, b)
		if horiz then
			return a.AbsolutePosition.Y < b.AbsolutePosition.Y + b.AbsoluteSize.Y
				and b.AbsolutePosition.Y < a.AbsolutePosition.Y + a.AbsoluteSize.Y
		end
		return a.AbsolutePosition.X < b.AbsolutePosition.X + b.AbsoluteSize.X
			and b.AbsolutePosition.X < a.AbsolutePosition.X + a.AbsoluteSize.X
	end

	local function isPressText(g)
		local t = g.Text:lower()
		return t:find("pressione e", 1, true) ~= nil or t:find("press e", 1, true) ~= nil
			or t:find("na zona", 1, true) ~= nil or t:find("in the zone", 1, true) ~= nil
	end

	-- Acha o PAINEL do minigame: pelo texto "Pressione E ..." (visível). Sem texto, pelos ancestrais das GUIs vermelhas.
	local function collectRoots(pg)
		local roots, seen, reds = {}, {}, {}
		local function add(r)
			if r and r ~= pg and r:IsA("GuiObject") and not seen[r] then
				seen[r] = true
				table.insert(roots, r)
			end
		end
		for _, g in ipairs(pg:GetDescendants()) do
			if g:IsA("GuiObject") and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) then
				if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Text ~= "" and isPressText(g) and Utils.shown(g) then
					local a = g.Parent
					for _ = 1, 3 do add(a) a = a and a.Parent end
				elseif g.AbsoluteSize.X > 4 and g.AbsoluteSize.Y > 4 and Utils.isRed(g) and Utils.shown(g) then
					table.insert(reds, g)
				end
			end
		end
		if #roots == 0 then
			for _, g in ipairs(reds) do
				local a = g.Parent
				for _ = 1, 4 do add(a) a = a and a.Parent end
			end
		end
		return roots
	end

	-- Dentro do painel: zona vermelha (maior primeiro) + objeto mais estreito que ela, no mesmo trecho da barra,
	-- que se MOVE. Se vários se movem (risco e estrela), usa o mais fino.
	local function scanRoots(roots, samples)
		local newSamples = {}
		for _, root in ipairs(roots) do
			local desc = root:GetDescendants()
			local reds = {}
			for _, g in ipairs(desc) do
				if g:IsA("GuiObject") and g.AbsoluteSize.X > 4 and g.AbsoluteSize.Y > 4 and Utils.isRed(g) and Utils.shown(g) then
					table.insert(reds, g)
				end
			end
			table.sort(reds, function(a, b)
				return a.AbsoluteSize.X * a.AbsoluteSize.Y > b.AbsoluteSize.X * b.AbsoluteSize.Y
			end)
			for _, g in ipairs(reds) do
				local horiz = g.AbsoluteSize.X >= g.AbsoluteSize.Y
				local limit = (horiz and g.AbsoluteSize.X or g.AbsoluteSize.Y) * 0.8
				local best, bestW
				for _, d in ipairs(desc) do
					if d ~= g and d:IsA("GuiObject") and d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0
						and not d:IsDescendantOf(g) and not g:IsDescendantOf(d) then
						local w = horiz and d.AbsoluteSize.X or d.AbsoluteSize.Y
						if w <= limit and overlap(horiz, g, d) and Utils.shown(d) then
							local pos = d.AbsolutePosition
							local old = samples[d]
							if old and (horiz and math.abs(pos.X - old.X) or math.abs(pos.Y - old.Y)) > 0.5 then
								if not best or w < bestW then best, bestW = d, w end
							end
							newSamples[d] = pos
						end
					end
				end
				if best then return g, best, {} end
			end
		end
		return nil, nil, newSamples
	end

	local function autoParts(dt)
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return nil end
		if auto.zone then
			if auto.zone:IsDescendantOf(pg) and auto.marker:IsDescendantOf(pg)
				and Utils.shown(auto.zone) and Utils.shown(auto.marker) and Utils.isRed(auto.zone) then
				return auto.marker, auto.zone
			end
			auto.zone, auto.marker, auto.samples = nil, nil, {}
		end
		auto.t += dt
		-- com o painel já localizado varre todo frame (barato); sem ele, só de vez em quando
		local need = auto.roots and 0 or ((os.clock() < Mini.windowUntil) and 0.1 or 0.5)
		if auto.t < need then return nil end
		auto.t = 0
		if auto.roots and not (auto.roots[1] and auto.roots[1].Parent and Utils.shown(auto.roots[1])) then
			auto.roots, auto.samples = nil, {}
		end
		if not auto.roots then
			local r = collectRoots(pg)
			if #r > 0 then auto.roots, auto.rootsAt, auto.samples = r, os.clock(), {} end
		end
		if not auto.roots then return nil end
		local z, m, s = scanRoots(auto.roots, auto.samples)
		if z then
			auto.zone, auto.marker, auto.samples = z, m, {}
			return m, z
		end
		auto.samples = s
		if os.clock() - auto.rootsAt > 1.5 then auto.roots = nil end -- repesquisa o painel
		return nil
	end

	local function keyByName(name)
		local ok, key = pcall(function() return Enum.KeyCode[name] end)
		if ok and key then return key end
		ok, key = pcall(function() return Enum.KeyCode[name:upper()] end)
		return ok and key or nil
	end

	-- E em duas camadas: evento de teclado virtual + chamada direta dos scripts que escutam InputBegan.
	-- A segunda funciona mesmo quando o jogo está em "modo toque" e ignora o teclado virtual.
	local function pressKey(key)
		pcall(function() VIM:SendKeyEvent(true, key, false, game) end)
		if Configuration.DirectInput and getconnections then
			local fake = {
				KeyCode = key, UserInputType = Enum.UserInputType.Keyboard,
				UserInputState = Enum.UserInputState.Begin, Position = Vector3.zero, Delta = Vector3.zero,
			}
			pcall(function()
				for _, c in ipairs(getconnections(UIS.InputBegan)) do
					pcall(function() c:Fire(fake, false) end)
				end
			end)
		end
		task.wait(0.06)
		pcall(function() VIM:SendKeyEvent(false, key, false, game) end)
	end

	local function hit(pos, gui)
		local remote = Utils.resolve(Configuration.Paths.PerfectRemote)
		if remote then
			Utils.call(remote, Configuration.Builders.Perfect())
			return
		end
		for part in Configuration.PerfectKey:gmatch("[^%+]+") do
			part = part:gsub("%s", "")
			if part:lower() == "click" then
				Utils.clickAt(pos, gui)
			else
				local key = keyByName(part)
				if not key then error("Tecla inválida: " .. tostring(part)) end
				pressKey(key)
			end
		end
	end

	local function between(a, b, c) return (a - c) * (b - c) <= 0 end

	local function step(dt)
		local usingManual = Configuration.Paths.PerfectMarker ~= "" and Configuration.Paths.PerfectLine ~= ""
		local marker, line
		if usingManual then marker, line = manualParts() else marker, line = autoParts(dt) end
		if not (marker and line and Utils.shown(marker) and Utils.shown(line)) then
			prev, velS, stale = nil, 0, false
			Mini.active = false
			return
		end
		local horiz = line.AbsoluteSize.X >= line.AbsoluteSize.Y
		local m = marker.AbsolutePosition + marker.AbsoluteSize / 2
		local l = line.AbsolutePosition + line.AbsoluteSize / 2
		local mc, lc = horiz and m.X or m.Y, horiz and l.X or l.Y
		local moved = (prev == nil) or math.abs(mc - prev) > 0.3
		if moved then moveAt = os.clock() end
		if stale then
			if not moved then prev = mc return end -- barra parada (resultado na tela): ignora
			stale = false
		end
		if not Mini.active then
			Mini.count += 1
			roundState.presses, roundState.last, moveAt = 0, 0, os.clock()
			task.spawn(Utils.wakeKeyboard)
		end
		Mini.active, Mini.seen = true, true
		if os.clock() - moveAt > 2.5 then
			stale, Mini.active, prev = true, false, mc
			return
		end
		local half = (horiz and line.AbsoluteSize.X or line.AbsoluteSize.Y) / 2
		local k = 1 - Configuration.PerfectPoint
		local pad = Configuration.PerfectTolerance
		local vel = prev and (mc - prev) / math.max(dt, 0.001) or 0
		velS = velS * 0.6 + vel * 0.4
		local pred = mc + velS * Configuration.PerfectLead
		local onLine = math.abs(pred - lc) <= half * k + pad
		local crossed = false
		-- risco rápido pode "pular" o vermelho entre dois frames: detecta o cruzamento do centro
		if prev and not onLine and math.abs(mc - prev) > 0.5 and between(prev, mc, lc) then crossed = true end
		prev = mc
		if (onLine or crossed) and roundState.presses < Configuration.PerfectPresses
			and os.clock() - roundState.last >= Configuration.PerfectCooldown then
			roundState.presses += 1
			roundState.last = os.clock()
			task.spawn(function()
				local ok, err = pcall(hit, l, line)
				if not ok then
					Utils.softError("Beg", err)
				end
			end)
		end
	end

	local function sync()
		local want = Toggles.Active("perfect") and not Hub.Destroyed
		if want and not beat then
			beat = RunService.Heartbeat:Connect(function(dt)
				local ok, err = pcall(step, dt)
				if not ok then
					Utils.softError("Beg", err)
				end
			end)
		elseif not want and beat then
			beat:Disconnect()
			beat, prev, Mini.active = nil, nil, false
		end
	end
	Toggles.Listen(sync)
	table.insert(Hub.Cleanup, { Destroy = function() if beat then beat:Disconnect() beat = nil end end })
	sync()
end }

