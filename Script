-- Raids: King of Curses (centro 1, vermelho) e The Strongest (centro 2, azul)
--==================================================================
Modules.Raids = { Name = "Raids", Icon = "🐉", Sub = "Raids automáticas", Init = function(page)
	local DIFF = {
		easy = { "fácil", "facil", "easy" },
		normal = { "normal", "medium", "médio", "medio" },
		hard = { "difícil", "dificil", "hard" },
	}
	local ALLDIFF = {}
	for _, l in pairs(DIFF) do for _, w in ipairs(l) do table.insert(ALLDIFF, w) end end
	local BEST = { "melhor", "best", "auto", "equip best" }
	local BEST_BAD = { "movimento", "move", "casa", "house", "sell", "vender", "exclus" }
	local START = { "iniciar", "start", "começar", "comecar", "begin", "lutar", "fight" }
	local NAMES = {
		red = { "king of curses", "curses" },      -- centro 1 (-146.24, 5.10, 487.69)
		blue = { "the strongest", "strongest" },   -- centro 2 (149.51, 6.21, 488.91)
	}
	local ENTRY = { "raid", "incurs", "invas", "king of curses", "strongest" }
	local ENTRY_BTN = { "invas", "incurs" }
	local OPEN = { "open", "aberto", "aberta" }
	local LIVE = { "join", "active", "live", "started", "ongoing", "entrar", "now" }
	local BOSS_NAME = { red = "King of Curses", blue = "The Strongest" }

	page:Section("Raid (King of Curses / The Strongest)")
	page:Choice("Dificuldade", {
		{ id = "easy", text = "Fácil" }, { id = "normal", text = "Normal" }, { id = "hard", text = "Difícil" },
	}, function() return Configuration.RaidDifficulty end, function(v)
		Configuration.RaidDifficulty = v
	end)
	local st = { diff = false, best = false, lastStart = 0, lastEntry = 0, goneAt = 0, padUntil = 0, lastPad = 0 }

	-- cor/centro pelo NOME da raid (ou pelas palavras vermelho/azul, caso apareçam)
	local function raidColor(text)
		text = text or ""
		if matches(text, NAMES.red) or text:find("vermelh", 1, true) or text:find("%f[%a]red%f[%A]") then return "red" end
		if matches(text, NAMES.blue) or text:find("azul", 1, true) or text:find("%f[%a]blue%f[%A]") then return "blue" end
		return nil
	end

	-- lê o aviso na tela ("NEXT RAID BOSS: King of Curses / The Strongest"), ignorando a loja
	local function hudBoss()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return nil end
		for _, g in ipairs(pg:GetDescendants()) do
			if g:IsA("TextLabel") and g.Text ~= "" and #g.Text < 40
				and not (Hub.Gui and g:IsDescendantOf(Hub.Gui)) and Utils.shown(g) then
				local t = cleanLower(g.Text)
				if not matches(t, NOT_RAID) and not t:find("altern", 1, true) and not t:find("every", 1, true) then
					if matches(t, NAMES.red) then return "red" end
					if matches(t, NAMES.blue) then return "blue" end
				end
			end
		end
		return nil
	end

	-- quantos prompts ativos existem perto de uma coordenada (ignora loja)
	local function nearPrompts(pos, radius)
		local n = 0
		for p in pairs(Prompts) do
			if p.Enabled and p:IsDescendantOf(workspace) and not npcPrompt(p) then
				local txt = (p.ObjectText .. " " .. p.ActionText .. " " .. p:GetFullName()):lower()
				local part = p.Parent
				if part and part:IsA("Attachment") then part = part.Parent end
				if part and part:IsA("BasePart") and not matches(txt, NOT_RAID)
					and (part.Position - pos).Magnitude <= radius then
					n += 1
				end
			end
		end
		return n
	end

	-- descobre qual raid começou:
	-- 1) nome no botão de Viagem  2) nome no aviso da tela  3) lado onde o prompt está ativo  4) alterna
	local function detectRaid(entryText)
		local c = raidColor(entryText)
		if c then return c end
		c = hudBoss() or st.hudColor
		if c then return c end
		for _, e in ipairs(Utils.buttons(true)) do
			if matches(e.text, ENTRY) and not matches(e.text, NOT_RAID) then
				c = raidColor(e.text)
				if c then return c end
			end
		end
		for _ = 1, 6 do
			local r = nearPrompts(Configuration.RaidPos.red, 45)
			local b = nearPrompts(Configuration.RaidPos.blue, 45)
			if r ~= b then return (r > b) and "red" or "blue" end
			task.wait(0.5)
		end
		return (st.lastColor == "red") and "blue" or "red"
	end

	local function goCenter(color)
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local pos = Configuration.RaidPos[color]
		if not (hrp and pos) then return end
		release()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, 1, 0))
		st.center, st.lastColor = pos, color
		st.stayUntil = os.clock() + math.random(Configuration.RaidStayMin, Configuration.RaidStayMax)
		Notifications.Push("Raid", "Indo para o centro de " .. BOSS_NAME[color] .. ".", "raid")
	end

	local function dialogRoot(btn)
		local a = btn.Parent
		for _ = 1, 6 do
			if not (a and a:IsA("GuiObject")) then break end
			local t = Utils.textOf(a)
			if t:find("dificuldade", 1, true) or t:find("difficulty", 1, true) or (matches(t, ENTRY) and matches(t, ALLDIFF)) then
				return a
			end
			a = a.Parent
		end
		return nil
	end

	local function analyzeDialog(list)
		for _, e in ipairs(list) do
			if e.shown and matches(e.text, START) and not matches(e.text, BEST_BAD) and not matches(e.text, NOT_RAID) then
				local root = dialogRoot(e.btn)
				if root then
					local d = { root = root, start = e.btn }
					for _, o in ipairs(list) do
						if o.shown and o.btn ~= e.btn and o.btn:IsDescendantOf(root) then
							if not d.diff and matches(o.text, DIFF[Configuration.RaidDifficulty]) and not matches(o.text, LOCKED) then
								d.diff = o.btn
							end
							if not d.best and matches(o.text, BEST) and not matches(o.text, BEST_BAD) then
								d.best = o.btn
							end
						end
					end
					return d
				end
			end
		end
		return nil
	end

	Feature(page, "raid", "Auto Raid",
		"Quando a raid abre (King of Curses ou The Strongest): vai ao centro certo, espera abrir, interage, escolhe a dificuldade, seleciona os melhores e inicia. Ignora o Raid Shop.",
		0.6, function()
			-- guarda qual boss está anunciado na tela (a cada 3s)
			if os.clock() - (st.hudAt or 0) > 3 then
				st.hudAt = os.clock()
				local c = hudBoss()
				if c then st.hudColor = c end
			end

			local list = Utils.buttons(true)
			local d = analyzeDialog(list)
			if d then
				st.goneAt, st.padUntil, st.center = os.clock(), 0, nil
				if not st.diff then
					if d.diff then Utils.clickGui(d.diff) task.wait(T("RaidWaitDiff")) end
					st.diff = true
				elseif not st.best then
					if d.best then Utils.clickGui(d.best) task.wait(T("RaidWaitBest")) end
					st.best = true
				elseif os.clock() - st.lastStart >= T("RaidStartEvery") then
					st.lastStart = os.clock()
					Utils.clickGui(d.start)
				end
				return
			end
			if os.clock() - st.goneAt > 4 then st.diff, st.best = false, false end

			-- fica no centro de 10 a 15 segundos esperando a raid abrir
			if st.center then
				if os.clock() < st.stayUntil then
					local char = LocalPlayer.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if hrp and (hrp.Position - st.center).Magnitude > 6 then
						hrp.CFrame = CFrame.new(st.center + Vector3.new(0, 1, 0))
					end
					if os.clock() - st.lastPad >= 1.5 then
						st.lastPad = os.clock()
						Utils.firePad(Configuration.RaidPadRadius)
					end
					return
				end
				-- passou o tempo e a raid não abriu: sai e tenta de novo
				st.center, st.padUntil, st.lastEntry = nil, 0, os.clock()
			end

			if os.clock() >= st.padUntil and os.clock() - st.lastEntry >= T("RaidEntryEvery") then
				for _, e in ipairs(list) do
					local t = e.text
					if not matches(t, ENTRY_BAD) and not matches(t, LOCKED) then
						local named = matches(t, NAMES.red) or matches(t, NAMES.blue)
						local opened = ((t:find("raid", 1, true) or named) and matches(t, OPEN))
							or (named and not t:find("%d+:%d%d") and matches(t, LIVE))
						local banner = matches(t, ENTRY_BTN) and not t:find("%d+:%d%d") and not t:find("%d+m%s*%d+s")
						if opened or banner then
							st.lastEntry = os.clock()
							if goTravel(e) then
								st.padUntil = os.clock() + 45
								task.wait(1.5)
								goCenter(detectRaid(t))
							end
							return
						end
					end
				end
			end

			if os.clock() < st.padUntil and os.clock() - st.lastPad >= 2 then
				st.lastPad = os.clock()
				if Utils.firePad(Configuration.RaidPadRadius) then return end
			end

			-- fora do centro: só interage com prompt de raid que NÃO seja a loja (Raid Shop / Shards)
			Utils.takeOver("raid", Configuration.Keywords.Raid, NOT_RAID)
			Utils.interact("raid", Configuration.Keywords.Raid, NOT_RAID, false)
		end)
	page:Info("Centro 1 (vermelho) = King of Curses. Centro 2 (azul) = The Strongest. A velocidade dos passos é ajustada em Farm > Config. Autofarm.")
end }

