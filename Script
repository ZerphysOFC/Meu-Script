				filter[key] = (not filter[key]) or nil
				paint()
				summary()
			end)
			paint()
		end
		summary()
	end
	build()
	table.insert(Refreshers, build)
	if withMode then
		table.insert(rows, page:Choice("Modo", {
			{ id = "strict", text = "Só as marcadas" }, { id = "first", text = "Marcadas primeiro" },
		}, function() return Configuration.StrictRarity and "strict" or "first" end, function(v)
			Configuration.StrictRarity = (v == "strict")
		end))
	end
	table.insert(rows, page:Button("Selecionar todas", function()
		for _, name in ipairs(Configuration.RarityOrder) do filter[name:lower()] = true end
		build()
	end))
	table.insert(rows, page:Button("Desmarcar todas", function()
		for k in pairs(filter) do filter[k] = nil end
		build()
	end))
	local open = false
	local function setOpen(v)
		open = v
		arrow.Text = v and "▲" or "▼"
		for _, r in ipairs(rows) do r.Visible = v end
